#!/usr/bin/env bash
set -euo pipefail

# vLLM systemd ExecStartPre. Preserve the gpt/full-gpt/local mode and refresh
# the OpenCode model metadata without changing cloud/local agent routing.
key="${VLLM_INSTANCE:-}"
if [ -z "$key" ]; then
  : "${SERVED_MODEL_NAME:?SERVED_MODEL_NAME or VLLM_INSTANCE is required}"
  for path in "$HOME"/.config/vllm/*.env; do
    [ -f "$path" ] || continue
    if grep -Fxq "SERVED_MODEL_NAME=$SERVED_MODEL_NAME" "$path"; then
      key="${path##*/}"
      key="${key%.env}"
      break
    fi
  done
fi
if [ -z "$key" ]; then
  echo "Unable to resolve active vLLM instance for OpenCode defaults" >&2
  exit 1
fi
exec "$HOME/.local/bin/opencode-model-policy" --mode keep --local-key "$key"
