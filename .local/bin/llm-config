#!/usr/bin/env bash
set -euo pipefail

# Restore the user's systemd bus in remote shells when available.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -S "/run/user/$(id -u)/bus" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] &&
   [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

choices=(
  "qwen3.6-35B-a3b:Qwen3.6 35B A3B"
  "qwen3.6-27B:Qwen3.8 27B"
)

usage() {
  cat <<'EOF'
Usage: llm-config [gpt|qwen3.6-35B-a3b|qwen3.6-27B]
       llm-config [--status|--sessions|--preflight|--restore-environment]
       llm-config --handoff SESSION_ID
       llm-config --queue
       llm-config --queue-resume
       llm-config --queue-cancel SESSION_ID

Primary OpenCode models:
  gpt                 GPT-6.1 Sol for Build, Plan, Design, Learn; vLLM for subagents
  qwen3.6-35B-a3b    Qwen3.6 35B A3B for primary agents and subagents
  qwen3.6-27B        Qwen3.8 27B for primary agents and subagents

Without MODEL, shows an interactive menu. During model changes, running
OpenCode sessions are grouped by the current TUI agent type and prompted
independently, with a separate 12-second timeout for EACH type:
  Build                 [Y/n] (Enter/timeout = YES)
  Plan, Learn, Design   [y/N] (Enter/timeout = NO)
  Other agents          [y/N] (Enter/timeout = NO)
No interactive terminal defaults to NO for all agents.
Declined groups retain their sessions and context. Approved, busy sessions
are QUEUED under systemd --user: the current tool and full AI turn finish
normally, then context is compacted (only if needed) and the model switched.
No Esc or abort is sent. The llm-config command returns after scheduling.
Use --queue to view progress, --queue-resume after reboot, or
--queue-cancel SESSION_ID to cancel. Queue state lives under ~/.local/state.
Shared vLLM server restarts still require affected sessions to be idle.
Selecting GPT never compacts.
Set
LLM_CONFIG_CONFIRM_TIMEOUT to change the timeout PER AGENT TYPE.
--sessions lists OpenCode processes without making changes.
The compaction agent inherits the TUI's current model. For old OpenCode TUIs
created before this policy was installed, a validated isolated sidecar is
used as a fallback; new TUIs compact natively without reopening.
--handoff SESSION_ID creates a private offline recovery prompt for a new local
session. It is lossy, costs no GPT quota, and preserves the original history.
--restore-environment imports the minimal LLM/ZeroClaw environment for the
single enabled vLLM target into the systemd user manager.
EOF
}

enabled_model() {
  local enabled=()
  local item key target
  for item in "${choices[@]}"; do
    key="${item%%:*}"
    target="vllm-${key}.target"
    if systemctl --user is-enabled --quiet "$target" 2>/dev/null; then
      enabled+=("$key")
    fi
  done
  if [ "${#enabled[@]}" -ne 1 ]; then
    printf 'Expected exactly one enabled vLLM target, found %s: %s\n' \
      "${#enabled[@]}" "${enabled[*]:-none}" >&2
    return 1
  fi
  printf '%s\n' "${enabled[0]}"
}

import_systemd_environment() {
  local model_key="$1"
  local profile_override="$HOME/.profile_override"
  local model_env="$HOME/.config/vllm/${model_key}.env"
  local uri_host

  [ -r "$profile_override" ] || {
    printf 'Missing readable secret source: %s\n' "$profile_override" >&2
    return 1
  }
  [ -r "$model_env" ] || {
    printf 'Missing model environment: %s\n' "$model_env" >&2
    return 1
  }

  set +u
  # shellcheck disable=SC1090
  . "$profile_override"
  set -u
  : "${VLLM_API_KEY:?VLLM_API_KEY is required in ~/.profile_override}"
  DESKTOP_COMMANDER_STATE_FILE="${DESKTOP_COMMANDER_STATE_FILE:-$HOME/.profile_override.desktop-commander.json}"
  export DESKTOP_COMMANDER_STATE_FILE
  systemctl --user import-environment DESKTOP_COMMANDER_STATE_FILE

  read_model_env() {
    local key="$1"
    awk -v key="$key" '
      index($0, key "=") == 1 {
        sub(/^[^=]*=/, "")
        print
        found = 1
        exit
      }
      END { if (!found) exit 1 }
    ' "$model_env"
  }

  SERVED_MODEL_NAME="$(read_model_env SERVED_MODEL_NAME)" || {
    printf 'SERVED_MODEL_NAME is required in %s\n' "$model_env" >&2
    return 1
  }
  PORT="$(read_model_env PORT)" || {
    printf 'PORT is required in %s\n' "$model_env" >&2
    return 1
  }
  HOST="$(read_model_env HOST 2>/dev/null || true)"

  uri_host="${HOST:-127.0.0.1}"
  case "$uri_host" in
    0.0.0.0|::|"[::]") uri_host=127.0.0.1 ;;
  esac

  export VLLM_API_KEY
  export ZEROCLAW_providers__models__vllm__default__api_key="$VLLM_API_KEY"
  export ZEROCLAW_providers__models__vllm__default__model="$SERVED_MODEL_NAME"
  export ZEROCLAW_providers__models__vllm__default__uri="http://${uri_host}:${PORT}/v1"

  systemctl --user import-environment \
    VLLM_API_KEY \
    ZEROCLAW_providers__models__vllm__default__api_key \
    ZEROCLAW_providers__models__vllm__default__model \
    ZEROCLAW_providers__models__vllm__default__uri

  if [ -n "${DISCORD_BOT:-}" ]; then
    export ZEROCLAW_channels__discord__default__bot_token="$DISCORD_BOT"
    systemctl --user import-environment ZEROCLAW_channels__discord__default__bot_token
    unset ZEROCLAW_channels__discord__default__bot_token
  else
    systemctl --user unset-environment ZEROCLAW_channels__discord__default__bot_token
  fi

  unset DISCORD_BOT VLLM_API_KEY DESKTOP_COMMANDER_STATE_FILE
  unset ZEROCLAW_providers__models__vllm__default__api_key
  unset ZEROCLAW_providers__models__vllm__default__model
  unset ZEROCLAW_providers__models__vllm__default__uri

  printf 'Imported private systemd environment for %s (%s)\n' "$model_key" "$SERVED_MODEL_NAME"
}

pick="${1:-}"
if [ "${pick:-}" = "-h" ] || [ "${pick:-}" = "--help" ]; then
  usage
  exit 0
fi
if [ "$pick" = "--queue" ]; then
  exec "$HOME/.local/bin/opencode-session-queue" status
fi
if [ "$pick" = "--queue-resume" ]; then
  exec "$HOME/.local/bin/opencode-session-queue" resume
fi
if [ "$pick" = "--queue-cancel" ]; then
  [ "$#" -eq 2 ] || { echo "Usage: llm-config --queue-cancel SESSION_ID" >&2; exit 2; }
  exec "$HOME/.local/bin/opencode-session-queue" cancel "$2"
fi
if [ "$pick" = "--handoff" ]; then
  [ "$#" -eq 2 ] || { echo "Usage: llm-config --handoff SESSION_ID" >&2; exit 2; }
  exec "$HOME/.local/bin/opencode-session-handoff" "$2"
fi
if [ "${pick:-}" = "--restore-environment" ]; then
  pick="$(enabled_model)"
  import_systemd_environment "$pick"
  exit 0
fi

policy="$HOME/.local/bin/opencode-model-policy"
transition="$HOME/.local/bin/opencode-session-transition"
transition_plan=""
transition_target=""
transition_display=""

cleanup_transition() {
  if [ -n "$transition_plan" ]; then
    printf 'Transition diagnostic kept: %s\n' "$transition_plan" >&2
  fi
}
trap cleanup_transition EXIT

active_local_model() {
  enabled_model
}
prepare_transition() {
  local mode="$1" key="$2" changing_vllm="${3:-no}"
  local envfile="$HOME/.config/vllm/$key.env" local_id local_name
  local opts=()
  if [ "$mode" = gpt ]; then
    transition_target="openai/gpt-6.1-sol"
    transition_display="GPT-6.1 Sol OpenAI"
  else
    [ -r "$envfile" ] || { echo "Missing $envfile" >&2; return 1; }
    local_id="$(sed -n 's/^SERVED_MODEL_NAME=//p' "$envfile" | head -1)"
    local_name="$(sed -n 's/^DISPLAY_MODEL_NAME=//p' "$envfile" | head -1)"
    [ -n "$local_id" ] && [ -n "$local_name" ] || {
      echo "Incomplete vLLM model metadata in $envfile" >&2; return 1;
    }
    transition_target="vllm/$local_id"
    transition_display="$local_name vLLM"
  fi
  mkdir -p -m 700 "$HOME/.local/state/llm-transitions"
  chmod 700 "$HOME/.local/state/llm-transitions"
  transition_plan="$(mktemp "$HOME/.local/state/llm-transitions/transition.XXXXXXXX")"
  chmod 600 "$transition_plan"
  if [ "$changing_vllm" = yes ]; then
    opts+=(--changing-vllm)
  fi
  "$transition" prepare --target "$transition_target" --display "$transition_display" --plan "$transition_plan" \
    --confirm-timeout "${LLM_CONFIG_CONFIRM_TIMEOUT:-12}" "${opts[@]}"
}
finish_transition() {
  if [ -z "$transition_plan" ]; then
    return
  fi
  "$transition" finish --target "$transition_target" --plan "$transition_plan" \
    --display "$transition_display" --label "$transition_display"
  rm -f -- "$transition_plan"
  transition_plan=""
}
route_primary() {
  local mode="$1" key
  key="$(active_local_model)"
  prepare_transition "$mode" "$key"
  "$policy" --mode "$mode" --local-key "$key"
  if ! systemctl --user is-active --quiet "vllm@$key.service"; then
    printf 'WARNING: vLLM service is not active; local subagents may fail.\n' >&2
  fi
  finish_transition
}
case "$pick" in
  gpt|openai/gpt-6.1-sol) route_primary gpt; exit 0 ;;
  --status|status) "$policy" --status --local-key "$(active_local_model)"; exit 0 ;;
  --preflight) "$HOME/.local/bin/opencode-context-preflight"; exit 0 ;;
  --sessions|--list-sessions) "$transition" list; exit 0 ;;
esac

if [ -z "$pick" ]; then
  echo "Select primary OpenCode model / active vLLM target:"
  i=1
  for item in "${choices[@]}"; do
    key="${item%%:*}"
    label="${item#*:}"
    printf '  %s) %s (%s)\n' "$i" "$label" "$key"
    i=$((i + 1))
  done
  printf '  3) GPT-6.1 Sol (keep vLLM for subagents)\n'
  printf 'Choice: '
  read -r answer
  case "$answer" in
    1) pick="qwen3.6-35B-a3b" ;;
    2) pick="qwen3.6-27B" ;;
    3) pick="gpt" ;;
    *) echo "Invalid choice: $answer" >&2; exit 2 ;;
  esac
fi

case "$pick" in
  gpt) route_primary gpt; exit 0 ;;
  qwen3.6-35B-a3b|qwen3.6-27B) ;;
  *) echo "Unknown model: $pick" >&2; usage >&2; exit 2 ;;
esac

if [ "$(active_local_model)" = "$pick" ] && systemctl --user is-active --quiet "vllm@$pick.service"; then
  prepare_transition local "$pick"
  "$policy" --mode local --local-key "$pick"
  finish_transition
  echo "vLLM already active; no service restart needed."
  exit 0
fi

prepare_transition local "$pick" yes
import_systemd_environment "$pick"

selected_target="vllm-${pick}.target"
selected_service="vllm@${pick}.service"
all_targets=()
all_services=()
other_targets=()
legacy_service="vllm.service"
for item in "${choices[@]}"; do
  key="${item%%:*}"
  target="vllm-${key}.target"
  service="vllm@${key}.service"
  all_targets+=("$target")
  all_services+=("$service")
  if [ "$target" != "$selected_target" ]; then
    other_targets+=("$target")
  fi
done

unit_state() {
  systemctl --user show "$1" --property="$2" --value 2>/dev/null || true
}

since="$(date --iso-8601=seconds)"
printf 'Stopping vLLM units through systemd...\n'
systemctl --user stop "$legacy_service" "${all_targets[@]}" "${all_services[@]}" 2>/dev/null || true

printf 'Persisting selected target: %s\n' "$selected_target"
systemctl --user daemon-reload
if [ "${#other_targets[@]}" -gt 0 ]; then
  systemctl --user disable "${other_targets[@]}" 2>/dev/null || true
fi
systemctl --user disable "$legacy_service" 2>/dev/null || true
systemctl --user enable "$selected_target"

printf 'Starting selected target: %s\n' "$selected_target"
systemctl --user reset-failed "$selected_target" "$selected_service" "${all_services[@]}" 2>/dev/null || true
systemctl --user start --no-block "$selected_target"

echo
systemctl --user --no-pager -l status "$selected_target" "$selected_service" || true

cat <<EOF

--- Current logs since $since: $selected_service ---
EOF
journalctl --user-unit "$selected_service" --since "$since" -n 40 --no-pager -o short-iso || true

cat <<EOF

--- Following new logs: $selected_service ---
EOF
journalctl --user-unit "$selected_service" --since "$since" -n 0 -f -o short-iso &
journal_pid=$!

while kill -0 "$journal_pid" 2>/dev/null; do
  service_state="$(unit_state "$selected_service" ActiveState)"
  service_result="$(unit_state "$selected_service" Result)"
  target_state="$(unit_state "$selected_target" ActiveState)"
  target_result="$(unit_state "$selected_target" Result)"

  if [ "$service_state" = active ] \
    && { [ -z "$service_result" ] || [ "$service_result" = success ]; }; then
    kill "$journal_pid" 2>/dev/null || true
    wait "$journal_pid" 2>/dev/null || true
    echo
    echo "$selected_service is active. Systemd will continue managing it."
    "$policy" --mode local --local-key "$pick"
    finish_transition
    systemctl --user --no-pager -l status "$selected_service" || true
    exit 0
  fi

  if [ "$service_state" = failed ] || { [ -n "$service_result" ] && [ "$service_result" != success ]; }; then
    kill "$journal_pid" 2>/dev/null || true
    wait "$journal_pid" 2>/dev/null || true
    echo
    echo "$selected_service failed: state=${service_state:-unknown} result=${service_result:-unknown}" >&2
    systemctl --user --no-pager -l status "$selected_service" >&2 || true
    exit 1
  fi

  if [ "$target_state" = failed ] || { [ -n "$target_result" ] && [ "$target_result" != success ]; }; then
    kill "$journal_pid" 2>/dev/null || true
    wait "$journal_pid" 2>/dev/null || true
    echo
    echo "$selected_target failed: state=${target_state:-unknown} result=${target_result:-unknown}" >&2
    systemctl --user --no-pager -l status "$selected_target" "$selected_service" >&2 || true
    exit 1
  fi

  sleep 2
done
wait "$journal_pid"
