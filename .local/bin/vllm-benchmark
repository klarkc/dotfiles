#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: vllm-benchmark [--check | prefix-switch]

Runs lightweight target-aware HTTP benchmarks against the active vLLM
OpenAI-compatible chat endpoint. Start a model first with vllm-config.

Without a subcommand, runs the legacy SMALL/MEDIUM/LONG sweep.

Subcommands:
  prefix-switch   Run the agent-switch / prefix-cache workload using
                  fully synthetic prompts whose token volume mimics
                  parallel coding-agent traffic. No real repo content
                  is sent.

Environment overrides:
  VLLM_BENCHMARK_ENV  Path to benchmark.env from a vLLM runtime cache
  SMALL_PROMPTS       Default: 4
  SMALL_INPUT_LEN     Default: 1024
  SMALL_OUTPUT_LEN    Default: 32
  MEDIUM_PROMPTS      Default: 4
  MEDIUM_INPUT_LEN    Default: 4096
  MEDIUM_OUTPUT_LEN   Default: 64
  LONG_PROMPTS        Default: 2
  LONG_INPUT_LEN      Default: 48000
  LONG_OUTPUT_LEN     Default: 64

Prefix-switch workload knobs:
  PREFIX_TOKENS       Repo+system+tool prefix size. Default: 32768
  SUFFIX_TOKENS       Per-agent history suffix. Default: 256
  COMPLETION_TOKENS   Generation length. Default: 64
  WARM_REPEATS        Warm reruns per agent. Default: 2
  INCLUDE_SOLOGIG     Run cross-project (1) or skip (0). Default: 1
  PASS_RATIO          Warm-vs-cold TTFT pass ratio (warm <= ratio*cold).
                      Default: 0.5
EOF
}

check_only=0
prefix_switch_only=0
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --check) check_only=1 ;;
  prefix-switch) prefix_switch_only=1 ;;
  "") ;;
  *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

find_benchmark_env() {
  local latest
  if [ -n "${VLLM_BENCHMARK_ENV:-}" ] && [ -r "$VLLM_BENCHMARK_ENV" ]; then
    printf '%s\n' "$VLLM_BENCHMARK_ENV"
    return 0
  fi
  latest="$(ls -t "$HOME"/.cache/vllm-*/benchmark.env 2>/dev/null | head -n 1 || true)"
  if [ -n "$latest" ] && [ -r "$latest" ]; then
    printf '%s\n' "$latest"
    return 0
  fi
  echo "No vLLM benchmark.env found. Start a model first with: vllm-config qwen3.6-35B-a3b" >&2
  return 1
}

load_env_key() {
  local env_file="$1"
  local key="$2"
  local line value
  line="$(grep -E "^${key}=" "$env_file" | tail -n 1 || true)"
  [ -n "$line" ] || return 0
  value="${line#*=}"
  value="${value%\"}"
  value="${value#\"}"
  printf -v "$key" '%s' "$value"
  export "$key"
}

redact_file() {
  local src="$1"
  local dst="$2"
  if [ -r "$src" ]; then
    sed -E \
      -e 's/(VLLM_API_KEY=).*/\1<redacted>/' \
      -e 's/(HF_TOKEN=).*/\1<redacted>/' \
      -e 's/(HF_HUB_TOKEN=).*/\1<redacted>/' \
      -e 's/(HUGGING_FACE_HUB_TOKEN=).*/\1<redacted>/' \
      "$src" > "$dst"
  fi
}

metric_value() {
  local key="$1"
  local file="$2"
  python3 - "$key" "$file" <<'PY'
import json, sys
key, path = sys.argv[1:]
with open(path, 'r', encoding='utf-8') as f:
    data = json.load(f)
value = data.get(key, '')
print(value if value is not None else '')
PY
}

write_summary() {
  local name="$1"
  local slug="$2"
  local file="$artifact_dir/${slug}.json"
  local out="$artifact_dir/${slug}.summary.env"
  local duration input_tokens output_tokens req_tps prefill_tps decode_tps total_tps mean_ttft p99_ttft mean_tpot failed

  duration="$(metric_value duration_s "$file")"
  input_tokens="$(metric_value total_prompt_tokens "$file")"
  output_tokens="$(metric_value total_completion_tokens "$file")"
  req_tps="$(metric_value request_tps "$file")"
  prefill_tps="$(metric_value prefill_tps "$file")"
  decode_tps="$(metric_value decode_tps "$file")"
  total_tps="$(metric_value total_tps "$file")"
  mean_ttft="$(metric_value mean_ttft_ms "$file")"
  p99_ttft="$(metric_value p99_ttft_ms "$file")"
  mean_tpot="$(metric_value mean_tpot_ms "$file")"
  failed="$(metric_value failed_requests "$file")"

  {
    echo "name=$name"
    echo "served_model=$MODEL"
    echo "base_url=$BASE_URL"
    echo "max_concurrency=2"
    echo "duration_s=$duration"
    echo "input_tokens=$input_tokens"
    echo "output_tokens=$output_tokens"
    echo "failed_requests=$failed"
    echo "request_tps=$req_tps"
    echo "prefill_tps=$prefill_tps"
    echo "decode_tps=$decode_tps"
    echo "total_tps=$total_tps"
    echo "mean_ttft_ms=$mean_ttft"
    echo "p99_ttft_ms=$p99_ttft"
    echo "mean_tpot_ms=$mean_tpot"
  } > "$out"

  cat <<EOF

--- $name metrics ---
failed_requests=${failed:-n/a}
request_tps=${req_tps:-n/a}
prefill_tps=${prefill_tps:-n/a}
decode_tps=${decode_tps:-n/a}
total_tps=${total_tps:-n/a}
mean_ttft_ms=${mean_ttft:-n/a}
p99_ttft_ms=${p99_ttft:-n/a}
mean_tpot_ms=${mean_tpot:-n/a}
EOF
}

capture_metadata() {
  {
    echo "timestamp=$timestamp"
    echo "benchmark_env=$benchmark_env"
    echo "instance=$instance"
    echo "instance_env=$instance_env"
    echo "served_model=$MODEL"
    echo "base_url=$BASE_URL"
    echo "max_concurrency=2"
    echo "small_requests=prompts:${SMALL_PROMPTS},input:${SMALL_INPUT_LEN},output:${SMALL_OUTPUT_LEN}"
    echo "medium_requests=prompts:${MEDIUM_PROMPTS},input:${MEDIUM_INPUT_LEN},output:${MEDIUM_OUTPUT_LEN}"
    echo "long_context_requests=prompts:${LONG_PROMPTS},input:${LONG_INPUT_LEN},output:${LONG_OUTPUT_LEN}"
  } > "$artifact_dir/metadata.env"

  systemctl --user --no-pager -l status "vllm@${instance}.service" fusion.service > "$artifact_dir/systemd-status.txt" 2>&1 || true
  journalctl --user-unit "vllm@${instance}.service" -n 700 --no-pager -o short-iso > "$artifact_dir/journal-vllm.txt" 2>&1 || true
  journalctl --user-unit fusion.service -n 300 --no-pager -o short-iso > "$artifact_dir/journal-fusion.txt" 2>&1 || true
  nvidia-smi > "$artifact_dir/nvidia-smi.txt" 2>&1 || true
  ps -eo pid,ppid,stat,pcpu,pmem,rss,vsz,args | grep -E 'vllm|fusion|tmux' | grep -v grep > "$artifact_dir/processes.txt" 2>&1 || true
  [ ! -r "$HOME/.cache/vllm-${instance}/runtime_command.sh" ] || cp "$HOME/.cache/vllm-${instance}/runtime_command.sh" "$artifact_dir/runtime_command.sh"
  redact_file "$benchmark_env" "$artifact_dir/benchmark.env"
  redact_file "$instance_env" "$artifact_dir/model.env"
}

finish_archive() {
  local run_status="$1"
  echo "$run_status" > "$artifact_dir/status.txt"
  capture_metadata
  tar -C "$artifact_root" -czf "$archive" "$(basename "$artifact_dir")"
  echo
  echo "Benchmark artifact: $archive"
}

run_case() {
  local name="$1"
  local slug="$2"
  local num_prompts="$3"
  local input_len="$4"
  local output_len="$5"
  local json_file="$artifact_dir/${slug}.json"
  local log_file="$artifact_dir/${slug}.log"

  echo
  echo "=== $name ==="
  echo "served_model=$MODEL base_url=$BASE_URL prompts=$num_prompts concurrency=2 input=$input_len output=$output_len"
  set +e
  python3 - "$BASE_URL" "$MODEL" "${VLLM_API_KEY:-}" "$num_prompts" "$input_len" "$output_len" "$json_file" <<'PY' 2>&1 | tee "$log_file"
import concurrent.futures
import json
import statistics
import sys
import time
import urllib.error
import urllib.request

base_url, model, api_key, prompts, input_len, output_len, out_path = sys.argv[1:]
prompts = int(prompts)
input_len = int(input_len)
output_len = int(output_len)
max_workers = min(2, prompts)
unit = 'Benchmark token. '
prompt = (unit * ((input_len // 3) + 2))[: input_len * 6]

def percentile(values, pct):
    if not values:
        return None
    values = sorted(values)
    index = min(len(values) - 1, max(0, int(round((pct / 100) * (len(values) - 1)))))
    return values[index]

def request_one(index):
    payload = {
        'model': model,
        'messages': [{'role': 'user', 'content': prompt}],
        'temperature': 0,
        'max_tokens': output_len,
        'stream': True,
        'stream_options': {'include_usage': True},
    }
    req = urllib.request.Request(
        base_url.rstrip('/') + '/chat/completions',
        data=json.dumps(payload).encode(),
        headers={
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + api_key,
        },
    )
    t0 = time.perf_counter()
    first = None
    chunks = 0
    chars = 0
    usage = {}
    try:
        with urllib.request.urlopen(req, timeout=3600) as response:
            for raw in response:
                if not raw.startswith(b'data: '):
                    continue
                data = raw[6:].strip()
                if data == b'[DONE]':
                    break
                obj = json.loads(data)
                if obj.get('usage'):
                    usage = obj['usage']
                choices = obj.get('choices') or []
                if not choices:
                    continue
                delta = choices[0].get('delta') or {}
                text = (
                    delta.get('content')
                    or delta.get('reasoning_content')
                    or delta.get('reasoning')
                    or delta.get('tool_calls')
                    or ''
                )
                if text:
                    if first is None:
                        first = time.perf_counter()
                    chunks += 1
                    chars += len(text) if isinstance(text, str) else len(json.dumps(text))
        t1 = time.perf_counter()
        completion_tokens = usage.get('completion_tokens') or max(1, chars // 4)
        prompt_tokens = usage.get('prompt_tokens') or input_len
        return {
            'request': index,
            'ok': True,
            'prompt_tokens': prompt_tokens,
            'completion_tokens': completion_tokens,
            'ttft_s': None if first is None else first - t0,
            'total_s': t1 - t0,
            'chunks': chunks,
        }
    except Exception as exc:
        t1 = time.perf_counter()
        return {
            'request': index,
            'ok': False,
            'error': repr(exc),
            'total_s': t1 - t0,
        }

start = time.perf_counter()
with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as pool:
    results = list(pool.map(request_one, range(1, prompts + 1)))
end = time.perf_counter()

ok = [r for r in results if r.get('ok')]
failed = [r for r in results if not r.get('ok')]
duration = end - start
prompt_tokens = sum(int(r.get('prompt_tokens') or 0) for r in ok)
completion_tokens = sum(int(r.get('completion_tokens') or 0) for r in ok)
ttfts = [float(r['ttft_s']) * 1000 for r in ok if r.get('ttft_s') is not None]
tpots = []
for r in ok:
    ttft = r.get('ttft_s')
    total = float(r.get('total_s') or 0)
    completion = int(r.get('completion_tokens') or 0)
    if ttft is not None and completion > 1 and total > ttft:
        tpots.append(((total - ttft) / max(1, completion - 1)) * 1000)

summary = {
    'model': model,
    'num_prompts': prompts,
    'max_concurrency': max_workers,
    'requested_input_len': input_len,
    'requested_output_len': output_len,
    'duration_s': round(duration, 3),
    'successful_requests': len(ok),
    'failed_requests': len(failed),
    'total_prompt_tokens': prompt_tokens,
    'total_completion_tokens': completion_tokens,
    'request_tps': round(len(ok) / max(0.001, duration), 4),
    'prefill_tps': round(prompt_tokens / max(0.001, duration), 2),
    'decode_tps': round(completion_tokens / max(0.001, duration), 2),
    'total_tps': round((prompt_tokens + completion_tokens) / max(0.001, duration), 2),
    'mean_ttft_ms': None if not ttfts else round(statistics.mean(ttfts), 2),
    'p99_ttft_ms': None if not ttfts else round(percentile(ttfts, 99), 2),
    'mean_tpot_ms': None if not tpots else round(statistics.mean(tpots), 2),
    'results': results,
}
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(summary, f, indent=2)
    f.write('\n')
print(json.dumps({k: v for k, v in summary.items() if k != 'results'}, indent=2))
if failed:
    print('Failed requests:', json.dumps(failed[:3], indent=2), file=sys.stderr)
    raise SystemExit(1)
PY
  local rc="${PIPESTATUS[0]}"
  set -e
  echo "$rc" > "$artifact_dir/${slug}.exit-code"
  if [ "$rc" -eq 0 ]; then
    write_summary "$name" "$slug"
  fi
  return "$rc"
}

run_prefix_switch() {
  local slug="prefix-switch"
  local json_file="$artifact_dir/${slug}.json"
  local log_file="$artifact_dir/${slug}.log"
  local csv_file="$artifact_dir/${slug}.csv"
  local summary_file="$artifact_dir/${slug}.summary.env"

  echo
  echo "=== Prefix-switch / agent-switch workload ==="
  echo "served_model=$MODEL base_url=$BASE_URL prefix_tokens=$PREFIX_TOKENS suffix_tokens=$SUFFIX_TOKENS completion_tokens=$COMPLETION_TOKENS warm_repeats=$WARM_REPEATS include_sologig=$INCLUDE_SOLOGIG pass_ratio=$PASS_RATIO"

  set +e
  python3 - "$BASE_URL" "$MODEL" "${VLLM_API_KEY:-}" \
    "$PREFIX_TOKENS" "$SUFFIX_TOKENS" "$COMPLETION_TOKENS" \
    "$WARM_REPEATS" "$INCLUDE_SOLOGIG" "$PASS_RATIO" \
    "$json_file" "$csv_file" "$summary_file" \
    "$artifact_dir" "$slug" \
    <<'PY' 2>&1 | tee "$log_file"
import csv
import json
import os
import random
import statistics
import sys
import time
import urllib.error
import urllib.request

(base_url, model, api_key, prefix_tokens, suffix_tokens, completion_tokens,
 warm_repeats, include_sologig, pass_ratio,
 json_path, csv_path, summary_path,
 artifact_dir, slug) = sys.argv[1:]

prefix_tokens = int(prefix_tokens)
suffix_tokens = int(suffix_tokens)
completion_tokens = int(completion_tokens)
warm_repeats = int(warm_repeats)
include_sologig = int(include_sologig)
pass_ratio = float(pass_ratio)

CHARS_PER_TOKEN = 4


def fetch_max_model_len():
    try:
        req = urllib.request.Request(
            base_url.rstrip('/') + '/models',
            headers={'Authorization': 'Bearer ' + api_key} if api_key else {},
        )
        with urllib.request.urlopen(req, timeout=15) as r:
            data = json.load(r)
        for entry in data.get('data', []):
            if entry.get('id') == model:
                return int(entry.get('max_model_len') or 0)
        if data.get('data'):
            return int(data['data'][0].get('max_model_len') or 0)
    except Exception as exc:
        print(f'WARN: could not fetch max_model_len: {exc!r}', file=sys.stderr)
    return 0


max_model_len = fetch_max_model_len()


def synth_block(target_chars, seed, label, salt):
    rng = random.Random(f"{seed}|{label}|{salt}")
    out = []
    out.append(f"[{label}] seed={seed} prologue directive {rng.randint(0, 9999)}")
    out.append("Operate as a coding agent across multiple repositories.")
    line_no = 0
    body = ''.join(rng.choice("abcdefghijklmnopqrstuvwxyz") for _ in range(48))
    while sum(len(x) for x in out) < target_chars:
        line_no += 1
        out.append(
            f"[{label} #{line_no:06d}] marker={rng.randint(0, 9999)} | " + body + " " + body
        )
    text = '\n'.join(out)
    return text[:target_chars]


def build_messages(seed, prefix_chars, suffix_chars, label):
    system_text = synth_block(8000, seed, label + '-system', salt=1)
    tool_text = synth_block(8000, seed, label + '-tools', salt=2)
    prefix_text = synth_block(prefix_chars, seed, label + '-repo', salt=3)
    suffix_rng = random.Random(f"{seed}|{label}-suffix|4")
    suffix_line = (
        f"[agent {seed}] history step {suffix_rng.randint(0, 9999)}: "
        + ('event ' * 14)
        + ''.join(suffix_rng.choice("abcdefghijklmnopqrstuvwxyz") for _ in range(56))
    )
    suffix_text = ''
    while len(suffix_text) < suffix_chars:
        suffix_text += '\n' + suffix_line
    suffix_text = suffix_text[:suffix_chars]
    return [
        {'role': 'system', 'content': system_text + '\n\n' + tool_text},
        {'role': 'user', 'content': prefix_text + suffix_text + '\n\nRespond briefly.'},
    ]


def http_post_chat(messages, max_tokens, temperature=0):
    payload = {
        'model': model,
        'messages': messages,
        'temperature': temperature,
        'max_tokens': max_tokens,
        'stream': True,
        'stream_options': {'include_usage': True},
    }
    url = base_url.rstrip('/') + '/chat/completions'
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + api_key,
        },
    )
    t0 = time.perf_counter()
    first = None
    usage = {}
    chars = 0
    http_status = None
    error_body = ''
    try:
        with urllib.request.urlopen(req, timeout=3600) as response:
            http_status = response.status
            for raw in response:
                if not raw.startswith(b'data: '):
                    continue
                data = raw[6:].strip()
                if data == b'[DONE]':
                    break
                obj = json.loads(data)
                if obj.get('usage'):
                    usage = obj['usage']
                choices = obj.get('choices') or []
                if not choices:
                    continue
                delta = choices[0].get('delta') or {}
                text = (
                    delta.get('content')
                    or delta.get('reasoning_content')
                    or delta.get('reasoning')
                    or ''
                )
                if text:
                    if first is None:
                        first = time.perf_counter()
                    chars += len(text) if isinstance(text, str) else len(json.dumps(text))
    except urllib.error.HTTPError as exc:
        try:
            error_body = exc.read().decode('utf-8', errors='replace')[:400]
        except Exception:
            error_body = ''
        return {
            'ok': False,
            'http_status': exc.code,
            'error': repr(exc),
            'error_body': error_body,
            'ttft_s': None,
            'total_s': time.perf_counter() - t0,
        }
    except Exception as exc:
        return {
            'ok': False,
            'http_status': http_status,
            'error': repr(exc),
            'error_body': error_body,
            'ttft_s': None,
            'total_s': time.perf_counter() - t0,
        }
    t1 = time.perf_counter()
    return {
        'ok': True,
        'http_status': http_status,
        'ttft_s': None if first is None else first - t0,
        'total_s': t1 - t0,
        'prompt_tokens': usage.get('prompt_tokens'),
        'completion_tokens': usage.get('completion_tokens'),
        'chars': chars,
    }


def scrape_metrics(_artifact_dir=None, _slug=None):
    """Scrape /metrics and return a dict.

    Behavior:
      - Always attempt to record ALL `vllm:*` names we observe so we never
        silently miss cache-related counters that this vLLM build does
        expose.
      - Flag counters whose names match `cache|prefix|hit|query` keywords.
      - On any failure, return `_error` and `_url` keys so the benchmark
        can continue running; the absence of one counter MUST NOT invalidate
        the run. TTFT cold/warm remains the primary signal.
      - The first scrape of a run is also written to <artifact>/<slug>.metrics.txt
        so the raw Prometheus text can be inspected offline.
    """
    result = {}
    base_root = base_url.rstrip('/')
    if base_root.endswith('/v1'):
        base_root = base_root[:-3]
    metrics_url = base_root + '/metrics'
    try:
        req = urllib.request.Request(
            metrics_url,
            headers={'Authorization': 'Bearer ' + api_key} if api_key else {},
        )
        with urllib.request.urlopen(req, timeout=15) as r:
            text = r.read().decode('utf-8', errors='replace')
    except Exception as exc:
        return {'_error': repr(exc), '_url': metrics_url}
    result['_url'] = metrics_url

    # Save the raw scrape once per run (best-effort; do not crash).
    if not scrape_metrics._wrote_raw and _artifact_dir and _slug:
        try:
            with open(f"{_artifact_dir}/{_slug}.metrics.txt", 'w', encoding='utf-8') as f:
                f.write(text)
            scrape_metrics._wrote_raw = True
        except Exception:
            pass

    keyword_hits = []
    base_names = []
    for line in text.splitlines():
        if not line or line.startswith('#'):
            continue
        parts = line.split(' ')
        if len(parts) < 2:
            continue
        name = parts[0]
        if not name.startswith('vllm:'):
            continue
        try:
            value = float(parts[-1])
        except ValueError:
            continue
        result[name] = value
        # Strip {...} label suffix so the headline list is readable.
        base = name.split('{', 1)[0]
        base_names.append(base)
        lname = base.lower()
        if any(k in lname for k in ('cache', 'prefix', 'hit', 'query')):
            keyword_hits.append(base)
    result['_keyword_hits'] = sorted(set(keyword_hits))
    result['_base_names'] = sorted(set(base_names))
    return result


scrape_metrics._wrote_raw = False


prefix_chars = prefix_tokens * CHARS_PER_TOKEN
suffix_chars = suffix_tokens * CHARS_PER_TOKEN


def probe_chars_per_token(probe_chars=4000):
    """Send a tiny non-streaming chat probe to derive a chars-per-token ratio.

    The probe uses synth_block-style content so the measured ratio matches the
    actual workload rather than a 'z'-fill baseline.
    """
    sys_text = synth_block(8000, 1, 'probe-system', salt=1) + '\n\n' + synth_block(8000, 1, 'probe-tools', salt=2)
    suf = 'event ' * 14 + ' ' + 'x' * 200
    prefix_text = synth_block(probe_chars, 1, 'probe-repo', salt=3)
    user_text = prefix_text + suf + '\n\nRespond briefly.'
    payload = {
        'model': model,
        'messages': [
            {'role': 'system', 'content': sys_text},
            {'role': 'user', 'content': user_text},
        ],
        'temperature': 0,
        'max_tokens': 1,
        'stream': False,
    }
    try:
        req = urllib.request.Request(
            base_url.rstrip('/') + '/chat/completions',
            data=json.dumps(payload).encode(),
            headers={
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + api_key,
            } if api_key else {'Content-Type': 'application/json'},
        )
        with urllib.request.urlopen(req, timeout=60) as r:
            data = json.load(r)
        n = int((data.get('usage') or {}).get('prompt_tokens') or 0)
        if n > 0:
            chars_sent = len(sys_text) + len(user_text)
            return chars_sent / n
    except urllib.error.HTTPError as exc:
        print(f'WARN: probe chat failed: HTTP {exc.code}', file=sys.stderr)
    except Exception as exc:
        print(f'WARN: probe chat failed: {exc!r}', file=sys.stderr)
    return None


requested_prefix_tokens = prefix_tokens
requested_prefix_chars = prefix_chars
chars_per_token_estimate = None
clamp_reason = None

if max_model_len:
    cpt = probe_chars_per_token(4000) or 3.0
    chars_per_token_estimate = cpt
    print(f'info: probe chars-per-token ratio = {cpt:.3f}', file=sys.stderr)
    safe_max = max_model_len - completion_tokens - 64
    overhead_chars = 16000 + suffix_chars + 64  # system+tool+suffix+reply
    # Add a 12% safety margin for content-shape variance across agents/seeds.
    safe_prefix_chars = max(0, int(safe_max * 0.88 * cpt) - overhead_chars)
    if prefix_chars > safe_prefix_chars:
        fitted_tokens = max(1024, int(safe_prefix_chars / cpt) // 32 * 32)
        fitted_chars = int(fitted_tokens * cpt)
        clamp_reason = (
            f'requested prefix_tokens={prefix_tokens} would exceed max_model_len={max_model_len} '
            f'(chars={prefix_chars} > safe={safe_prefix_chars}); '
            f'clamped to prefix_tokens={fitted_tokens} (chars={fitted_chars})'
        )
        print(f'WARN: {clamp_reason}', file=sys.stderr)
        prefix_tokens = fitted_tokens
        prefix_chars = fitted_chars

agents = [
    ('A', 1, 'dotfiles'),
    ('B', 2, 'dotfiles'),
    ('C', 3, 'dotfiles'),
]

rows = []
metrics_per_request = []


def run_request(agent, run_index, kind, prefix_chars_used, suffix_chars_used, label, seed):
    messages = build_messages(seed, prefix_chars_used, suffix_chars_used, label)
    resp = http_post_chat(messages, completion_tokens)
    m = scrape_metrics(artifact_dir, slug)
    metrics_per_request.append({'agent': agent, 'kind': kind, 'index': run_index, 'metrics': m})
    row = {
        'agent': agent,
        'kind': kind,
        'index': run_index,
        'http_status': resp.get('http_status'),
        'ok': resp.get('ok'),
        'ttft_s': resp.get('ttft_s'),
        'total_s': resp.get('total_s'),
        'prompt_tokens': resp.get('prompt_tokens'),
        'completion_tokens': resp.get('completion_tokens'),
        'chars': resp.get('chars', 0),
        'prefix_chars': prefix_chars_used,
        'suffix_chars': suffix_chars_used,
        'completion_target_tokens': completion_tokens,
        'error': resp.get('error', ''),
        'error_body': resp.get('error_body', ''),
    }
    rows.append(row)
    return row


# Cold sequence: A, B, C
for agent, seed, label in agents:
    run_request(agent, 0, 'cold', prefix_chars, suffix_chars, label, seed)

# Warm reruns
for agent, seed, label in agents:
    for r in range(1, warm_repeats + 1):
        run_request(agent, r, 'warm', prefix_chars, suffix_chars, label, seed)

# SoloSIG-shaped cross-project variant
if include_sologig == 1:
    run_request('SoloSIG', 0, 'cold', prefix_chars, suffix_chars, 'solosig', 99)
    for r in range(1, warm_repeats + 1):
        run_request('SoloSIG', r, 'warm', prefix_chars, suffix_chars, 'solosig', 99)


# Write CSV
fieldnames = [
    'agent', 'kind', 'index', 'http_status', 'ok',
    'ttft_s', 'total_s', 'prompt_tokens', 'completion_tokens', 'chars',
    'prefix_chars', 'suffix_chars', 'completion_target_tokens',
    'error', 'error_body',
]
with open(csv_path, 'w', encoding='utf-8', newline='') as f:
    writer = csv.DictWriter(f, fieldnames=fieldnames)
    writer.writeheader()
    for row in rows:
        writer.writerow({k: row.get(k) for k in fieldnames})


# Build summary
def by_kind(agent_name, kind):
    return [r for r in rows if r['agent'] == agent_name and r['kind'] == kind and r.get('ok')]


def best_ttft(rs):
    vals = [r['ttft_s'] for r in rs if r.get('ttft_s') is not None]
    return min(vals) if vals else None


def avg_ttft(rs):
    vals = [r['ttft_s'] for r in rs if r.get('ttft_s') is not None]
    return statistics.mean(vals) if vals else None


summary_rows = []
verdicts = []
for agent, seed, _label in agents:
    cold_ttft = best_ttft(by_kind(agent, 'cold'))
    warm_ttfts = [best_ttft(by_kind(agent, 'warm'))]
    warm_avg = avg_ttft(by_kind(agent, 'warm'))
    warm2 = best_ttft([r for r in by_kind(agent, 'warm') if r['index'] >= 2])
    if cold_ttft is None or warm_ttfts[0] is None:
        verdict = 'no-data'
    else:
        ratio = warm_ttfts[0] / cold_ttft
        verdict = 'pass' if ratio <= pass_ratio else 'fail'
        verdicts.append(verdict)
    summary_rows.append({
        'agent': agent,
        'cold_ttft_s': cold_ttft,
        'warm1_ttft_s': warm_ttfts[0],
        'warm2_ttft_s': warm2,
        'warm_avg_ttft_s': warm_avg,
        'cold_prompt_tokens': (by_kind(agent, 'cold')[0].get('prompt_tokens') if by_kind(agent, 'cold') else None),
        'verdict': verdict,
    })

if include_sologig == 1:
    cold = best_ttft(by_kind('SoloSIG', 'cold'))
    warm1 = best_ttft(by_kind('SoloSIG', 'warm'))
    if cold is None or warm1 is None:
        verdict = 'no-data'
    else:
        ratio = warm1 / cold
        verdict = 'pass' if ratio <= pass_ratio else 'fail'
        verdicts.append(verdict)
    summary_rows.append({
        'agent': 'SoloSIG',
        'cold_ttft_s': cold,
        'warm1_ttft_s': warm1,
        'warm2_ttft_s': best_ttft([r for r in by_kind('SoloSIG', 'warm') if r['index'] >= 2]),
        'warm_avg_ttft_s': avg_ttft(by_kind('SoloSIG', 'warm')),
        'cold_prompt_tokens': (by_kind('SoloSIG', 'cold')[0].get('prompt_tokens') if by_kind('SoloSIG', 'cold') else None),
        'verdict': verdict,
    })


# Metrics observed across the run
observed_metrics = {}
for entry in metrics_per_request:
    m = entry.get('metrics') or {}
    for k, v in m.items():
        if k == '_error':
            observed_metrics.setdefault('_last_error', v)
            continue
        # Prometheus counters are cumulative; record first/last values.
        observed_metrics.setdefault(k, {'first': v, 'last': v})
        observed_metrics[k]['last'] = v


# Write JSON
with open(json_path, 'w', encoding='utf-8') as f:
    json.dump({
        'model': model,
        'requested_prefix_tokens': requested_prefix_tokens,
        'estimated_actual_prefix_tokens': prefix_tokens,
        'requested_prefix_chars': requested_prefix_chars,
        'estimated_actual_prefix_chars': prefix_chars,
        'chars_per_token_estimate': chars_per_token_estimate,
        'clamp_reason': clamp_reason,
        'max_model_len': max_model_len,
        'suffix_tokens': suffix_tokens,
        'completion_tokens': completion_tokens,
        'warm_repeats': warm_repeats,
        'include_sologig': include_sologig,
        'pass_ratio': pass_ratio,
        'rows': rows,
        'summary': summary_rows,
        'metrics': observed_metrics,
    }, f, indent=2)
    f.write('\n')


# Write summary.env for downstream tooling
with open(summary_path, 'w', encoding='utf-8') as f:
    f.write(f"name=prefix-switch\n")
    f.write(f"served_model={model}\n")
    f.write(f"base_url={base_url}\n")
    f.write(f"prefix_tokens={prefix_tokens}\n")
    f.write(f"suffix_tokens={suffix_tokens}\n")
    f.write(f"completion_tokens={completion_tokens}\n")
    f.write(f"warm_repeats={warm_repeats}\n")
    f.write(f"include_sologig={include_sologig}\n")
    f.write(f"pass_ratio={pass_ratio}\n")
    f.write(f"requested_prefix_tokens={requested_prefix_tokens}\n")
    f.write(f"estimated_actual_prefix_tokens={prefix_tokens}\n")
    f.write(f"requested_prefix_chars={requested_prefix_chars}\n")
    f.write(f"estimated_actual_prefix_chars={prefix_chars}\n")
    f.write(f"chars_per_token_estimate={chars_per_token_estimate}\n")
    f.write(f"max_model_len={max_model_len}\n")
    if clamp_reason:
        f.write(f"clamp_reason={clamp_reason}\n")
    for s in summary_rows:
        f.write(f"ttft_{s['agent']}_cold_s={s['cold_ttft_s']}\n")
        f.write(f"ttft_{s['agent']}_warm1_s={s['warm1_ttft_s']}\n")
        f.write(f"ttft_{s['agent']}_warm2_s={s['warm2_ttft_s']}\n")
        f.write(f"ttft_{s['agent']}_warm_avg_s={s['warm_avg_ttft_s']}\n")
        f.write(f"prompt_tokens_{s['agent']}_cold={s['cold_prompt_tokens']}\n")
        f.write(f"verdict_{s['agent']}={s['verdict']}\n")
    overall = 'pass' if verdicts and all(v == 'pass' for v in verdicts) else ('fail' if verdicts else 'no-data')
    f.write(f"overall_verdict={overall}\n")


# Console output
print()
print('--- prefix-switch summary ---')
print(f"{'agent':<10}{'cold_ttft_s':>15}{'warm1_ttft_s':>16}{'warm2_ttft_s':>16}{'warm_avg_s':>15}{'prompt_tokens':>16}  verdict")
for s in summary_rows:
    def fmt(v, spec='.3f'):
        return '' if v is None else format(v, spec)
    cold_s = fmt(s['cold_ttft_s'])
    warm1_s = fmt(s['warm1_ttft_s'])
    warm2_s = fmt(s['warm2_ttft_s'])
    warm_avg_s = fmt(s['warm_avg_ttft_s'])
    prompt_s = '' if s['cold_prompt_tokens'] is None else str(s['cold_prompt_tokens'])
    print(
        f"{s['agent']:<10}"
        f"{cold_s:>15}"
        f"{warm1_s:>16}"
        f"{warm2_s:>16}"
        f"{warm_avg_s:>15}"
        f"{prompt_s:>16}  {s['verdict']}"
    )
print()
print('--- /metrics counters observed ---')
if not observed_metrics:
    print('(no metrics available)')
# Collect keyword hits across all per-request scrapes for the headline summary.
all_keyword_hits = set()
all_base_names = set()
for entry in metrics_per_request:
    m = entry.get('metrics') or {}
    for h in (m.get('_keyword_hits') or []):
        all_keyword_hits.add(h)
    for n in (m.get('_base_names') or []):
        all_base_names.add(n)
if all_keyword_hits:
    print('keyword_hits (cache|prefix|hit|query):')
    for h in sorted(all_keyword_hits):
        print(f'  - {h}')
else:
    print('keyword_hits (cache|prefix|hit|query): (none)')
print()
print(f'all vllm:* counter base names observed ({len(all_base_names)}):')
for n in sorted(all_base_names):
    marker = ' *' if n in all_keyword_hits else ''
    print(f'  - {n}{marker}')
for k, v in observed_metrics.items():
    if k == '_last_error':
        print(f'metrics_error={v}')
        continue
    marker = ' *' if k in all_keyword_hits else ''
    print(f"{k}: first={v['first']} last={v['last']}{marker}")
print()
print(f"overall_verdict={('pass' if verdicts and all(v == 'pass' for v in verdicts) else ('fail' if verdicts else 'no-data'))}")
print(f"CSV: {csv_path}")
print(f"JSON: {json_path}")
print(f"Summary: {summary_path}")
print(f"Raw /metrics: {artifact_dir}/{slug}.metrics.txt")

if any(not r.get('ok') for r in rows):
    print('Some requests failed; see log for details.', file=sys.stderr)
    raise SystemExit(1)
PY
  local rc="${PIPESTATUS[0]}"
  set -e
  echo "$rc" > "$artifact_dir/${slug}.exit-code"
  return "$rc"
}

