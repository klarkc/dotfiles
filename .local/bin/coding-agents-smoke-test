#!/usr/bin/env python3
"""Verify real OpenCode MCP calls to Bitbucket, Jira and Confluence.

Codex remains only for ChatGPT OAuth bootstrapping, not as a coding agent.
PR content and credentials are never printed.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path


def fail(message):
    raise SystemExit("coding-agents-smoke-test: FAIL " + message)


def auth_available(model, config):
    provider = model.split("/")[0]
    options = (config.get("provider", {}).get(provider) or {}).get("options", {})
    key = options.get("apiKey", "")
    if isinstance(key, str) and key.startswith("{env:") and key.endswith("}"):
        return bool(os.environ.get(key[5:-1]))
    if provider == "openai":
        path = Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser() / "opencode/auth.json"
        try:
            cred = json.loads(path.read_text())["openai"]
            return cred.get("type") == "oauth" and bool(cred.get("access"))
        except (OSError, KeyError, ValueError, TypeError):
            return False
    return bool(os.environ.get("OPENAI_API_KEY") or os.environ.get("ANTHROPIC_API_KEY"))


def extract_status(text):
    snippets = []
    seen_tools = []
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        part = event.get("part") or {}
        if isinstance(part, dict):
            if isinstance(part.get("tool"), str):
                state = part.get("state") or {}
                seen_tools.append((part["tool"], state.get("status")))
            if isinstance(part.get("text"), str):
                snippets.append(part["text"])
        for name in ("text", "message"):
            if isinstance(event.get(name), str):
                snippets.append(event[name])
    report = None
    for snippet in snippets:
        candidates = [snippet.strip().strip(chr(96))]
        candidates += re.findall(r"~~~(?:json)?\s*(\{.*?\})\s*~~~", snippet, re.S)
        for body in candidates:
            try:
                obj = json.loads(body)
                if isinstance(obj, dict) and "bitbucket" in obj:
                    report = obj
            except ValueError:
                pass
    return report, seen_tools


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "api-token"
    if mode == "oauth":
        print("coding-agents-smoke-test: duplicate OAuth pass skipped")
        return
    if mode not in ("api-token", "full"):
        fail("expected api-token, oauth or full")
    cfg = Path(os.environ.get("CODING_AGENTS_OPENCODE_CONFIG") or
               os.environ.get("OPENCODE_CONFIG") or
               "~/.config/opencode/opencode.json").expanduser()
    try:
        config = json.loads(cfg.read_text())
    except (OSError, ValueError):
        fail("OpenCode configuration unavailable")
    model = os.environ.get("CODING_AGENTS_MODEL") or config.get("model")
    if not model or not auth_available(model, config):
        fail(f"OpenCode provider authentication unavailable for {model}")
    prompt = (
        "Call the REAL read-only MCP tool bitbucket_read_bitbucketPullRequest "
        "with action=list, workspaceId=solo_sig, repoId=solosig, "
        "state=OPEN, pagelen=1. Do not guess or use a shell. "
        "Do not make any writes. Reply ONLY with JSON {\"bitbucket\": true} "
        "if the tool succeeded and returned a genuine list of pull requests; "
        "otherwise reply ONLY with JSON {\"bitbucket\": false}."
    )
    if mode == "full":
        prompt += (
            " Also use atlassian getVisibleJiraProjects and atlassian "
            "getConfluenceSpaces for solosig.atlassian.net, and include "
            "boolean jira and confluence fields in the JSON. "
            "Only report true for tools returning real resources."
        )
    try:
        result = subprocess.run(
            ["opencode", "run", "--format", "json", "-m", model, prompt],
            capture_output=True, text=True,
            timeout=int(os.environ.get("CODING_AGENTS_TIMEOUT_SECONDS", "180")),
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        fail(f"OpenCode run unavailable ({type(exc).__name__})")
    if result.returncode:
        fail(f"OpenCode run exit {result.returncode}")
    report, tools = extract_status(result.stdout)
    if report is None:
        fail("OpenCode returned no final status JSON")
    products = ("bitbucket", "jira", "confluence") if mode == "full" else ("bitbucket",)
    for name in products:
        if report.get(name) is not True:
            fail(f"{name} not reachable from OpenCode")
    if not any("bitbucket_read_bitbucketPullRequest" in tool for tool, _ in tools):
        fail("no Bitbucket read-only MCP tool call recorded")
    if mode == "full" and not any("atlassian" in tool.lower() for tool, _ in tools):
        fail("no Atlassian MCP tool call recorded")
    print("coding-agents-smoke-test: PASS OpenCode actual Bitbucket PR MCP call" +
          (" plus Jira/Confluence" if mode == "full" else ""))


if __name__ == "__main__":
    main()
