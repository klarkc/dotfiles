#!/usr/bin/env bash
# coding-agents-smoke-test
#
# Verifies that the user's active coding agents can use the Atlassian
# Rovo MCP integration to request real Bitbucket, Jira, and Confluence
# resources. This is an agent-mediated smoke test: for each active
# coding agent (opencode, codex, pi) it issues a constrained prompt
# asking the agent to call Atlassian MCP tools and return a fixed JSON
# status object. The agent is REQUIRED to make real MCP tool calls
# and return real resource data, not just speculate.
#
# Lives under .local/bin/ because it requires live process invocations
# and depends on user state; it must NOT be added to nix flake check.
#
# Per-agent probe (drives the real agent, not a direct MCP call):
#   - opencode: `opencode run --format json <prompt>` parses JSON events
#     and looks for the final assistant message containing the
#     expected status object.
#   - codex:    `codex exec --json <prompt>` parses JSONL events and
#     reads the final agent message.
#   - pi:       `pi -p --mode json --no-session --provider <p> <prompt>`.
#
# Provider credential detection (env-only; never reads outside the
# worktree):
#   - opencode: parses the opencode.json inside the worktree (path
#     overridable via CODING_AGENTS_OPENCODE_CONFIG). If the configured
#     model has no usable provider credential, the probe is SKIPPED.
#   - codex: requires OPENAI_API_KEY. Otherwise SKIPPED.
#   - pi:     requires a provider credential (defaults to google;
#     needs GOOGLE_KEYFILE). Otherwise SKIPPED.
#
# Expected prompt output (final assistant message):
#   {"bitbucket": <bool>, "jira": <bool>, "confluence": <bool>,
#    "bitbucket_evidence": <string>, "jira_evidence": <string>,
#    "confluence_evidence": <string>}
#
# Acceptance:
#   - At least one agent must return a parseable status object. If all
#     agents are SKIPPED (no provider auth available), the smoke test
#     fails because there is no proof of agent-mediated access.
#   - For each of Bitbucket/Jira/Confluence, at least one agent that
#     ran must report `true` for that product. If no agent reports
#     true for a product, the smoke test fails.
#   - SKIP markers from individual agents do not block PASS for
#     products reported as true by other agents.
#
# Output policy: never print tokens, Authorization headers, generated
# Basic base64 strings, or raw agent log lines that could include
# secrets. The smoke output is reduced to per-product reachability
# status plus the user-supplied evidence strings.
#
# Exit codes:
#   0  All products reachable via real MCP tool calls from at least
#      one active coding agent that returned a parseable status.
#   6  At least one product is unreachable, or no agent returned a
#      parseable status object (all SKIPPED).

set -euo pipefail

readonly ATLASSIAN_URL='https://mcp.atlassian.com/v1/mcp/authv2'
readonly OPENCODE_CONFIG="${CODING_AGENTS_OPENCODE_CONFIG:-${HOME}/.config/opencode/opencode.json}"
readonly CODEX_CONFIG="${CODING_AGENTS_CODEX_CONFIG:-${CODEX_HOME:-${HOME}/.codex}/config.toml}"
readonly PI_SETTINGS="${CODING_AGENTS_PI_SETTINGS:-${HOME}/.pi/settings.json}"
readonly TIMEOUT_SECONDS="${CODING_AGENTS_TIMEOUT_SECONDS:-90}"
readonly WORKTREE_DEFAULT_OPENCODE_CONFIG='.config/opencode/opencode.json'

log() {
  printf 'coding-agents-smoke-test: %s\n' "$*"
}

fail() {
  printf 'coding-agents-smoke-test: FAIL: %s\n' "$*" >&2
  exit "${2:-1}"
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

# Redact obvious secret patterns from arbitrary text.
redact() {
  local value="$1"
  if [ -n "${ATLASSIAN_MCP_TOKEN:-}" ]; then
    value="${value//${ATLASSIAN_MCP_TOKEN}/[REDACTED]}"
  fi
  if [ -n "${ATLASSIAN_USER_EMAIL:-}" ]; then
    value="${value//${ATLASSIAN_USER_EMAIL}/[EMAIL]}"
  fi
  value="$(printf '%s' "$value" | sed -E 's/ATATT[A-Za-z0-9+\/=_-]{20,}/[ATLASSIAN_TOKEN]/g')"
  value="$(printf '%s' "$value" | sed -E 's/(Authorization:[[:space:]]*)(Bearer|Basic)[[:space:]]+[A-Za-z0-9+\/=._-]+/\1\2 [REDACTED]/g')"
  printf '%s' "$value"
}

# The probe prompt: ask the agent to use Atlassian MCP and report a
# fixed JSON status object. The prompt explicitly forbids making up
# results; the agent must call real tools.
build_probe_prompt() {
  cat <<'PROMPT'
You have an Atlassian MCP server configured (name: atlassian, endpoint: https://mcp.atlassian.com/v1/mcp/authv2).

Make real MCP tool calls and fetch real resources. Do not speculate. For each of the three products below, if the corresponding MCP tool call succeeds and returns at least one real resource, the value is true; otherwise false.

- Bitbucket: use bitbucketWorkspace or bitbucketRepository against workspace "solo_sig" repository "solosig".
- Jira: use getVisibleJiraProjects against https://solosig.atlassian.net.
- Confluence: use getConfluenceSpaces against https://solosig.atlassian.net.

Reply with ONLY this JSON object, no other text:
{"bitbucket": <bool>, "jira": <bool>, "confluence": <bool>, "bitbucket_evidence": "<one short sentence about what you got>", "jira_evidence": "<one short sentence>", "confluence_evidence": "<one short sentence>"}
PROMPT
}

# Run a command with a hard timeout; capture stdout. Use SIGKILL after
# the grace period so a hung agent process cannot block the smoke
# loop indefinitely.
run_with_timeout() {
  local cmd_file="$1"
  shift
  timeout --foreground --kill-after=5 "${TIMEOUT_SECONDS}" "$@" >"$cmd_file" 2>/dev/null || return "$?"
  return 0
}

# Extract the last JSON object from a stream. The agent may emit
# either pure JSON (single object/array) or JSONL events; we want the
# last assistant message containing our status object.
extract_status_json() {
  local raw_file="$1"
  python3 - "$raw_file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        text = f.read()
except Exception:
    sys.exit(0)
if not text.strip():
    sys.exit(0)

# Try JSONL first.
for line in reversed(text.splitlines()):
    line = line.strip()
    if not line:
        continue
    if not (line.startswith("{") and line.endswith("}")):
        continue
    try:
        obj = json.loads(line)
    except Exception:
        continue
    if isinstance(obj, dict) and "bitbucket" in obj and "jira" in obj and "confluence" in obj:
        print(json.dumps(obj))
        sys.exit(0)

# Fallback: search the whole text for the status object.
import re
candidates = []
for m in re.finditer(r"\{[^{}]*\"bitbucket\"[^{}]*\"jira\"[^{}]*\"confluence\"[^{}]*\}", text):
    try:
        obj = json.loads(m.group(0))
    except Exception:
        continue
    if isinstance(obj, dict):
        candidates.append(obj)
if candidates:
    print(json.dumps(candidates[-1]))
    sys.exit(0)
sys.exit(0)
PY
}

# opencode: drive the agent with a constrained prompt and parse the
# JSON output. Returns 0 always. Emits either a status JSON line or a
# skip line on stdout.
probe_opencode() {
  if ! have_cmd opencode; then
    log "opencode: not installed"
    return 0
  fi

  local cfg="${CODING_AGENTS_OPENCODE_CONFIG:-$WORKTREE_DEFAULT_OPENCODE_CONFIG}"
  if [ ! -f "$cfg" ]; then
    log "opencode: config not found at $cfg; skipping agent probe"
    printf 'opencode: SKIP\n'
    return 0
  fi

  # Check whether the configured model/provider has a usable
  # credential. Without provider auth, invoking `opencode run` will
  # hang waiting for a provider or fail unhelpfully.
  local has_auth model
  has_auth="$(python3 - "$cfg" <<'PY'
import json, os, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
providers = data.get("provider") or {}
model = data.get("model") or ""
provider_name, _, _ = model.partition("/")
ok = False
if provider_name and provider_name in providers:
    api_key = providers[provider_name].get("options", {}).get("apiKey", "") or ""
    if isinstance(api_key, str) and api_key.startswith("{env:"):
        env_var = api_key[len("{env:"):-1]
        if os.environ.get(env_var):
            ok = True
if ok:
    print("yes")
    sys.exit(0)
# Fallback: any well-known provider env var present.
for v in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY"):
    if os.environ.get(v):
        print("yes")
        sys.exit(0)
print("no")
PY
)"
  model="$(python3 -c "import json; print(json.load(open('$cfg')).get('model',''))")"

  if [ "$has_auth" != "yes" ]; then
    log "opencode: provider auth not available for the configured model ($model); skipping agent probe"
    printf 'opencode: SKIP\n'
    return 0
  fi

  local prompt
  prompt="$(build_probe_prompt)"
  local raw_file
  raw_file="$(mktemp)"
  local status_json
  if run_with_timeout "$raw_file" opencode run --format json -m "$model" "$prompt"; then
    status_json="$(extract_status_json "$raw_file")"
  else
    status_json=""
  fi
  rm -f "$raw_file"
  if [ -z "$status_json" ]; then
    log "opencode: agent probe did not return a parseable status object"
    printf 'opencode: SKIP\n'
    return 0
  fi
  printf 'opencode: %s\n' "$(redact "$status_json")"
}

# codex: similar to opencode but using codex exec --json.
probe_codex() {
  if ! have_cmd codex; then
    log "codex: not installed"
    printf 'codex: SKIP\n'
    return 0
  fi

  if [ -z "${OPENAI_API_KEY:-}" ]; then
    log "codex: OPENAI_API_KEY missing; skipping agent probe"
    printf 'codex: SKIP\n'
    return 0
  fi

  local prompt
  prompt="$(build_probe_prompt)"
  local raw_file
  raw_file="$(mktemp)"
  local status_json
  if run_with_timeout "$raw_file" codex exec --json --skip-git-repo-check "$prompt"; then
    status_json="$(extract_status_json "$raw_file")"
  else
    status_json=""
  fi
  rm -f "$raw_file"
  if [ -z "$status_json" ]; then
    log "codex: agent probe did not return a parseable status object"
    printf 'codex: SKIP\n'
    return 0
  fi
  printf 'codex: %s\n' "$(redact "$status_json")"
}

# pi: --print mode with --mode json. Requires a provider credential;
# default provider is google.
probe_pi() {
  if ! have_cmd pi; then
    log "pi: not installed"
    printf 'pi: SKIP\n'
    return 0
  fi

  local provider="${CODING_AGENTS_PI_PROVIDER:-google}"
  if [ "$provider" = "google" ] && [ -z "${GOOGLE_KEYFILE:-}" ]; then
    log "pi: GOOGLE_KEYFILE missing; skipping agent probe"
    printf 'pi: SKIP\n'
    return 0
  fi

  local prompt
  prompt="$(build_probe_prompt)"
  local raw_file
  raw_file="$(mktemp)"
  local status_json
  if run_with_timeout "$raw_file" pi -p --mode json --no-session --provider "$provider" "$prompt"; then
    status_json="$(extract_status_json "$raw_file")"
  else
    status_json=""
  fi
  rm -f "$raw_file"
  if [ -z "$status_json" ]; then
    log "pi: agent probe did not return a parseable status object"
    printf 'pi: SKIP\n'
    return 0
  fi
  printf 'pi: %s\n' "$(redact "$status_json")"
}

main() {
  # Accept and ignore mode arguments so this script can be driven by
  # the generic `make test` smoke loop, which calls every script with
  # `api-token` and `oauth`. This script does its own discovery and
  # does not consume those modes.
  while [ $# -gt 0 ]; do
    case "$1" in
      api-token|oauth) shift ;;
      *) break ;;
    esac
  done

  log "probing active coding agents for Atlassian MCP resource access"

  local probe_output
  probe_output="$(
    probe_opencode
    probe_codex
    probe_pi
  )"

  if [ -z "$probe_output" ]; then
    log "no coding agent could be probed (missing provider credentials or tools)"
    log "to enable a probe: ensure the agent's provider auth is available, then rerun"
    fail "Bitbucket, Jira, and Confluence could not be verified via any active coding agent" 6
  fi

  printf '%s\n' "$probe_output"

  # Combine all per-agent status objects, ignoring SKIP lines.
  local combined=""
  combined="$(printf '%s' "$probe_output" | awk -F': ' '
    /^[a-z]+: \{/ { print substr($0, index($0, "{") ) }
  ')"

  local probe_count
  probe_count="$(printf '%s' "$combined" | grep -c '^{')"

  if [ "$probe_count" = "0" ]; then
    log "no coding agent returned a parseable status object (all skipped)"
    log "to enable probes: ensure the agent's provider auth is available, then rerun"
    log "the direct atlassian-smoke-test still confirms the MCP endpoint is reachable"
    log "this smoke test cannot prove agent-mediated access without provider credentials"
    fail "no coding agent returned a parseable status object" 6
  fi

  local products_status=0
  for product in bitbucket jira confluence; do
    local reachable=0
    local raw
    raw="$(printf '%s' "$combined" | python3 -c "
import json, sys
product = '$product'
any_ok = False
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except Exception:
        continue
    if isinstance(obj, dict) and obj.get(product) is True:
        any_ok = True
sys.stdout.write('yes' if any_ok else 'no')
")"
    if [ "$raw" = "yes" ]; then
      reachable=1
    fi
    if [ "$reachable" = "1" ]; then
      log "$product: reachable via real MCP tool calls from at least one active coding agent"
    else
      log "$product: NOT reachable via real MCP tool calls from any active coding agent"
      products_status=1
    fi
  done

  if [ "$products_status" -ne 0 ]; then
    fail "one or more Atlassian products are not reachable via real MCP tool calls from any active coding agent" 6
  fi

  log "PASS coding-agents smoke test"
}

main "$@"
