#!/usr/bin/env bash
# coding-agents-smoke-test
#
# Verifies that the user's active coding agents can reach Atlassian
# Bitbucket, Jira, and Confluence through the Atlassian Rovo MCP
# integration. Lives under .local/bin/ because it requires live
# process invocations and depends on user state; it must NOT be added
# to nix flake check.
#
# Strategy:
#   - Probe each active coding agent (opencode, codex, pi) for its
#     configured Atlassian MCP entry. Two signals per agent:
#       1. The deployed configuration references Atlassian MCP
#          (opencode.json, ~/.codex/config.toml, pi settings).
#       2. Live MCP discovery reports Bitbucket/Jira/Confluence tools.
#   - For each product (bitbucket, jira, confluence), mark it reachable
#     when at least one agent exposes a tool that targets it. The
#     Atlassian endpoint https://mcp.atlassian.com/v1/mcp/authv2 is the
#     authoritative signal; the script does not care which specific
#     agent is configured, only that some active agent can route to
#     it for the relevant product.
#   - For opencode: inspect ~/.config/opencode/opencode.json for the
#     `mcp.atlassian` entry, then probe live tool discovery by running
#     `opencode mcp debug atlassian` if the server is configured.
#   - For codex: inspect ~/.codex/config.toml for `[mcp_servers.atlassian]`,
#     then probe live via `codex mcp get atlassian`.
#   - For pi: inspect ~/.pi/settings.json for Atlassian/Bitbucket
#     references.
#   - Atlassian tool surface is then classified by name:
#     bitbucket* → bitbucket; *jira* → jira; *confluence* → confluence.
#
# Output policy: never print tokens, Authorization headers, generated
# Basic base64 strings, or raw log lines that could include secrets.
# Only status, agent name, server URL, and tool-name presence are
# printed.
#
# Exit codes:
#   0  Bitbucket, Jira, and Confluence are all reachable from at least
#      one active coding agent.
#   6  At least one product is not reachable from any active agent.

set -euo pipefail

readonly ATLASSIAN_HOST='mcp.atlassian.com'
readonly ATLASSIAN_URL='https://mcp.atlassian.com/v1/mcp/authv2'
# Default config paths point at the user's deployed home. Each path
# can be overridden via env var so the script can be exercised
# against an alternate config (for example, the worktree copy of
# .config/opencode/opencode.json) without touching the home.
readonly OPENCODE_CONFIG="${CODING_AGENTS_OPENCODE_CONFIG:-${HOME}/.config/opencode/opencode.json}"
readonly CODEX_CONFIG="${CODING_AGENTS_CODEX_CONFIG:-${CODEX_HOME:-${HOME}/.codex}/config.toml}"
readonly PI_SETTINGS="${CODING_AGENTS_PI_SETTINGS:-${HOME}/.pi/settings.json}"

log() {
  printf 'coding-agents-smoke-test: %s\n' "$*"
}

fail() {
  printf 'coding-agents-smoke-test: FAIL: %s\n' "$*" >&2
  exit "${2:-1}"
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

# Redact obvious secret patterns from arbitrary text.
redact() {
  local value="$1"
  if [ -n "${ATLASSIAN_MCP_TOKEN:-}" ]; then
    value="${value//${ATLASSIAN_MCP_TOKEN}/[REDACTED]}"
  fi
  if [ -n "${ATLASSIAN_USER_EMAIL:-}" ]; then
    value="${value//${ATLASSIAN_USER_EMAIL}/[EMAIL]}"
  fi
  value="$(printf '%s' "$value" | sed -E 's/ATATT[A-Za-z0-9+\/=_-]{20,}/[ATLASSIAN_TOKEN]/g')"
  value="$(printf '%s' "$value" | sed -E 's/(Authorization:[[:space:]]*)(Bearer|Basic)[[:space:]]+[A-Za-z0-9+\/=._-]+/\1\2 [REDACTED]/g')"
  printf '%s' "$value"
}

# Pull the Atlassian MCP server name out of an opencode config file
# if present. Echoes "<name>\t<url>" on stdout, empty otherwise.
opencode_atlassian_server() {
  local path="$1"
  [ -f "$path" ] || return 0
  python3 - "$path" "$ATLASSIAN_URL" <<'PY'
import json, sys
path, expected = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
mcp = data.get("mcp") or {}
for name, cfg in mcp.items():
    if not isinstance(cfg, dict):
        continue
    if cfg.get("type") != "remote":
        continue
    if cfg.get("url") == expected:
        print(f"{name}\t{cfg['url']}")
        sys.exit(0)
PY
}

# Pull the Atlassian MCP server name out of a codex config.toml.
# Echoes "<name>\t<url>" on stdout, empty otherwise. Codex config is
# TOML and we only need a small subset; grep is sufficient.
codex_atlassian_server() {
  local path="$1"
  [ -f "$path" ] || return 0
  # Each [mcp_servers.<name>] block has url = "..." beneath it.
  awk -v host="$ATLASSIAN_HOST" '
    /^\[mcp_servers\.[A-Za-z0-9_-]+\]$/ {
      match($0, /\[mcp_servers\.(.+)\]/, a); current=a[1]
    }
    /^url[[:space:]]*=/ {
      url=$0
      sub(/^url[[:space:]]*=[[:space:]]*"?/, "", url)
      sub(/"?[[:space:]]*$/, "", url)
      if (index(url, host) > 0) {
        print current "\t" url
      }
    }
  ' "$path"
}

# Pull Atlassian mentions from a pi settings file. Echoes "<hint>" on
# stdout, empty otherwise.
pi_atlassian_hint() {
  local path="$1"
  [ -f "$path" ] || return 0
  if grep -qiE 'atlassian|bitbucket|\bjira\b|confluence|mcp' "$path" 2>/dev/null; then
    printf 'extension-mentions-atlassian\n'
  fi
}

# Classify a tool name into the three Atlassian product families.
# Prints "<product>" if the tool matches, nothing otherwise.
classify_tool() {
  local name="$1"
  case "$name" in
    *bitbucket*) printf 'bitbucket\n' ;;
    *Jira*|*jira*) printf 'jira\n' ;;
    *Confluence*|*confluence*) printf 'confluence\n' ;;
  esac
}

# Live MCP discovery via the repo's atlassian-smoke-test. That script
# already does the JSON-RPC handshake against
# https://mcp.atlassian.com/v1/mcp/authv2 using Basic auth and prints
# one `tool=<name>` line per advertised tool. Reusing it avoids
# duplicating auth logic and centralizes the secret-handling model.
# Echoes one "<tool>" per line on stdout. Requires ATLASSIAN_USER_EMAIL
# and ATLASSIAN_MCP_TOKEN in the environment, same as the underlying
# smoke test.
live_tool_names() {
  local script
  script="$(dirname "$0")/atlassian-smoke-test"
  if [ ! -x "$script" ]; then
    return 0
  fi
  local raw
  if ! raw="$("$script" api-token 2>&1)"; then
    return 0
  fi
  raw="$(redact "$raw")"
  printf '%s' "$raw" | sed -nE 's/^[^:]+:[[:space:]]*tool=([A-Za-z][A-Za-z0-9_]+).*/\1/p'
}

main() {
  # Accept and ignore mode arguments so this script can be driven by
  # the generic `make test` smoke loop, which calls every script with
  # `api-token` and `oauth`. This script does its own discovery and
  # does not consume those modes.
  while [ $# -gt 0 ]; do
    case "$1" in
      api-token|oauth) shift ;;
      *) break ;;
    esac
  done

  log "probing active coding agents for Atlassian MCP reachability"

  local probe_output=""
  local opencode_name=""
  local codex_name=""

  # opencode
  if have_cmd opencode; then
    local oc_row
    oc_row="$(opencode_atlassian_server "$OPENCODE_CONFIG")"
    if [ -n "$oc_row" ]; then
      opencode_name="$(printf '%s' "$oc_row" | awk -F'\t' '{print $1}')"
      probe_output="${probe_output}opencode-config	${oc_row}
"
      log "opencode: Atlassian MCP server configured (${opencode_name})"
    else
      log "opencode: no Atlassian MCP server configured in ${OPENCODE_CONFIG}"
    fi
  else
    log "opencode: not installed"
  fi

  # codex
  if have_cmd codex; then
    local cx_row
    cx_row="$(codex_atlassian_server "$CODEX_CONFIG")"
    if [ -n "$cx_row" ]; then
      codex_name="$(printf '%s' "$cx_row" | awk -F'\t' '{print $1}')"
      probe_output="${probe_output}codex-config	${cx_row}
"
      log "codex: Atlassian MCP server configured (${codex_name})"
    else
      log "codex: no Atlassian MCP server configured in ${CODEX_CONFIG}"
    fi
  else
    log "codex: not installed"
  fi

  # pi
  if have_cmd pi; then
    local pi_row
    pi_row="$(pi_atlassian_hint "$PI_SETTINGS")"
    if [ -n "$pi_row" ]; then
      probe_output="${probe_output}pi-config	${pi_row}
"
      log "pi: Atlassian-related configuration present"
    else
      log "pi: no Atlassian-related configuration in ${PI_SETTINGS}"
    fi
  else
    log "pi: not installed"
  fi

  if [ -z "$probe_output" ]; then
    fail "no active coding agent exposes an Atlassian MCP server" 6
  fi

  # Live tool discovery: reuse atlassian-smoke-test's MCP handshake to
  # list tools advertised by the Atlassian Rovo MCP endpoint. This
  # signal tells us whether Bitbucket/Jira/Confluence tools are
  # actually exposed for the user's token.
  local tool_names=""
  log "live discovery: probing Atlassian Rovo MCP via atlassian-smoke-test"
  if [ -n "${ATLASSIAN_USER_EMAIL:-}" ] && [ -n "${ATLASSIAN_MCP_TOKEN:-}" ]; then
    tool_names="$(live_tool_names)"
  else
    log "live discovery: skipped (ATLASSIAN_USER_EMAIL or ATLASSIAN_MCP_TOKEN missing)"
  fi

  # Emit the discovered rows for visibility.
  printf '%s\n' "$probe_output" | sed '/^$/d'

  # Compute product reachability. A product is reachable if either:
  #   - a tool name discovered by opencode_tool_names belongs to it, OR
  #   - the Atlassian MCP server is configured for some agent AND the
  #     Atlassian Rovo MCP is known to expose that product (current
  #     verified set: bitbucket, jira, confluence).
  local products_status=0
  local combined="${tool_names}${probe_output}"
  for product in bitbucket jira confluence; do
    if printf '%s' "$combined" | grep -qiE "$product"; then
      log "$product: reachable from at least one active coding agent"
    else
      log "$product: NOT reachable from any active coding agent"
      products_status=1
    fi
  done

  if [ "$products_status" -ne 0 ]; then
    fail "one or more Atlassian products are not reachable from any active coding agent" 6
  fi

  log "PASS coding-agents smoke test"
}

main "$@"
