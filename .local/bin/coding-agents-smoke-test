#!/usr/bin/env python3
"""End-to-end Bitbucket PR proof through a real OpenCode model and MCP tool.

Never accept the model's claim alone: require a completed MCP tool event,
a real list response with PR IDs, and a final model response referencing one.
Stdin is closed explicitly to avoid the OpenCode 1.18.x CLI bootstrap hang.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

TOOL = "bitbucket_read_bitbucketPullRequest"
ROOT = Path(__file__).resolve().parents[2]


def fail(message: str) -> None:
    raise SystemExit("coding-agents-smoke-test: FAIL: " + message)


def token_available() -> bool:
    path = Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser() / "opencode/auth.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8")).get("openai", {})
    except (OSError, ValueError, TypeError):
        return False
    return data.get("type") == "oauth" and bool(data.get("access"))


def choose_model(config: dict) -> str:
    explicit = os.environ.get("CODING_AGENTS_MODEL")
    if explicit:
        return explicit
    openai_models = list(config.get("provider", {}).get("openai", {}).get("models", {}))
    if token_available() and openai_models:
        return "openai/" + openai_models[0]
    return config.get("model", "")


def unwrap_prs(data: object, depth: int = 0) -> list[int]:
    if depth > 8:
        return []
    if isinstance(data, dict):
        values = data.get("values")
        if isinstance(values, list):
            return [
                entry["id"] for entry in values
                if isinstance(entry, dict)
                and isinstance(entry.get("id"), int)
                and not isinstance(entry.get("id"), bool)
                and entry["id"] > 0
            ]
        for key in ("data", "result", "items", "pullrequests"):
            if key in data:
                result = unwrap_prs(data[key], depth + 1)
                if result:
                    return result
    return []


def inspect_events(output: str) -> tuple[int | None, bool, list[str]]:
    ids: list[int] = []
    texts: list[str] = []
    tools: list[str] = []
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        part = event.get("part")
        if not isinstance(part, dict):
            continue
        if part.get("type") == "text":
            texts.append(part.get("text", ""))
        if part.get("type") != "tool" or part.get("tool") != TOOL:
            continue
        state = part.get("state") or {}
        if state.get("status") != "completed":
            continue
        arguments = state.get("input") or {}
        if (
            arguments.get("action") != "list"
            or arguments.get("workspaceId") != "solo_sig"
            or arguments.get("repoId") != "solosig"
        ):
            continue
        raw = state.get("output")
        if not isinstance(raw, str):
            continue
        try:
            data = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(data, dict) or data.get("isError") or data.get("error"):
            continue
        actual = unwrap_prs(data)
        if actual:
            ids.extend(actual)
            tools.append(TOOL)
    verified_id = ids[0] if ids else None
    final_text = texts[-1] if texts else ""
    # An agent finalizing with the real ID shows that it consumed the MCP
    # result, not merely that a tool invocation was emitted.
    referenced_id = (
        verified_id is not None
        and re.search(r"(?<![0-9])" + str(verified_id) + r"(?![0-9])", final_text) is not None
    )
    return verified_id, referenced_id, tools


def selftest() -> None:
    tool = {
        "type": "tool_use",
        "part": {
            "type": "tool",
            "tool": TOOL,
            "state": {
                "status": "completed",
                "input": {"action": "list", "workspaceId": "solo_sig", "repoId": "solosig"},
                "output": json.dumps({"values": [{"id": 29}], "pagelen": 1}),
            },
        },
    }
    text = {"type": "text", "part": {"type": "text", "text": "The first PR is #29."}}
    def encode(*events: dict) -> str:
        return "\n".join(json.dumps(event) for event in events)
    if inspect_events(encode(tool, text)) != (29, True, [TOOL]):
        fail("selftest rejected real successful tool evidence")
    if inspect_events(encode(text))[0] is not None:
        fail("selftest accepted hallucinated textual evidence")
    tool["part"]["state"]["status"] = "error"
    if inspect_events(encode(tool, text))[0] is not None:
        fail("selftest accepted errored MCP tool evidence")
    print("coding-agents-smoke-test: offline selftest PASS")


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "api-token"
    if mode == "--selftest":
        selftest()
        return
    if mode == "oauth":
        print("coding-agents-smoke-test: duplicate OAuth pass skipped (PR already tested)")
        return
    if mode not in ("api-token", "full"):
        fail("expected api-token, oauth or full")

    cfg = Path(
        os.environ.get("CODING_AGENTS_OPENCODE_CONFIG")
        or os.environ.get("OPENCODE_CONFIG")
        or ROOT / ".config/opencode/opencode.json"
    ).expanduser()
    try:
        config = json.loads(cfg.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        fail("OpenCode configuration unreadable")

    model = choose_model(config)
    if not model:
        fail("no model configured for OpenCode")
    if model.startswith("openai/") and not token_available():
        fail("OpenCode OAuth credentials unavailable")

    with tempfile.TemporaryDirectory(prefix="bitbucket-agent-e2e-") as tmp:
        test_config = dict(config)
        mcp = dict(config.get("mcp", {}))
        # Rovo and Atlassian products are verified separately; a single
        # Bitbucket MCP isolates this proof from remote OAuth delays.
        if "atlassian" in mcp:
            mcp["atlassian"] = {**mcp["atlassian"], "enabled": mode == "full"}
        mcp["bitbucket_read"] = {
            "type": "local",
            "command": [sys.executable, str(ROOT / ".local/bin/bitbucket-read-mcp")],
            "enabled": True,
            "timeout": 120000,
        }
        test_config["mcp"] = mcp
        agent_name = "bitbucket_pr_smoke"
        agents = dict(test_config.get("agent", {}))
        allow = {TOOL: True}
        permission = {"*": "deny", TOOL: "allow"}
        if mode == "full":
            allow["atlassian_*"] = True
            permission["atlassian_*"] = "allow"
        agents[agent_name] = {
            "description": "Read-only test agent. Only approved MCP tools.",
            "mode": "primary",
            "model": model,
            "tools": {"*": False, **allow},
            "permission": permission,
        }
        test_config["agent"] = agents
        test_config["default_agent"] = agent_name
        test_config["tools"] = {"*": False, **allow}
        test_config["permission"] = permission
        config_path = Path(tmp) / "opencode.json"
        config_path.write_text(json.dumps(test_config), encoding="utf-8")
        config_path.chmod(0o600)
        env = os.environ.copy()
        env["OPENCODE_CONFIG"] = str(config_path)
        # Rovo's own smoke tests cover its remote backend. Prefer fast REST
        # here; this remains a genuine call through the same local MCP.
        env.setdefault("BITBUCKET_READ_BACKEND", "rest")
        prompt = (
            "Use the real MCP tool bitbucket_read_bitbucketPullRequest with "
            "action=list, workspaceId=solo_sig, repoId=solosig, state=OPEN, pagelen=1. "
            "If none exist, try state=MERGED. Answer with the exact first PR ID "
            "from the returned values, like PR #123. No other tools. Do not invent."
        )
        if mode == "full":
            prompt += (
                " Also use Atlassian MCP to read a Jira project and a Confluence "
                "space; report only data actually returned by the tools."
            )
        try:
            run = subprocess.run(
                [
                    "opencode", "run", "--pure", "--format", "json",
                    "--agent", agent_name, "-m", model,
                    "--title", "Bitbucket PR read E2E smoke",
                    prompt,
                ],
                capture_output=True,
                text=True,
                stdin=subprocess.DEVNULL,  # CRITICAL: Bun.stdin.text must see EOF.
                timeout=int(os.environ.get("CODING_AGENTS_TIMEOUT_SECONDS", "180")),
                env=env,
                check=False,
            )
        except (subprocess.TimeoutExpired, OSError) as exc:
            fail(f"OpenCode run could not complete ({type(exc).__name__})")
        if run.returncode != 0:
            fail(f"OpenCode run returned status {run.returncode}")

    pr_id, cited, tools = inspect_events(run.stdout)
    if not tools or pr_id is None:
        fail("no completed Bitbucket PR MCP tool event with real PR data")
    if not cited:
        fail("model did not reference the PR ID returned by the MCP tool")
    print(
        "coding-agents-smoke-test: PASS model="+model
        +" tool="+TOOL
        +" tool_status=completed PR="+str(pr_id)
        +" model_referenced_pr=true"
    )


if __name__ == "__main__":
    main()
