#!/usr/bin/env python3
"""End-to-end Bitbucket PR proof through a real OpenCode model and MCP tool.

Never accept the model's claim alone: require a completed MCP tool event,
a real list response with PR IDs, and a final model response referencing one.
Stdin is closed explicitly to avoid the OpenCode 1.18.x CLI bootstrap hang.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

TOOL = "bitbucket_read_bitbucketPullRequest"
ROOT = Path(__file__).resolve().parents[2]


def load_private_config() -> None:
    if not (Path.home() / ".profile_override").is_file():
        return
    try:
        proc = subprocess.run(
            ["bash", "-c", 'set +x; source "$HOME/.profile_override" >/dev/null 2>&1; env -0'],
            capture_output=True, text=False, check=False,
        )
    except OSError:
        fail("could not load .profile_override")
    if proc.returncode:
        fail("could not load .profile_override")
    for item in proc.stdout.split(b"\0"):
        if b"=" in item:
            key, value = item.split(b"=", 1)
            try:
                os.environ[key.decode()] = value.decode()
            except UnicodeDecodeError:
                pass


def fail(message: str) -> None:
    raise SystemExit("coding-agents-smoke-test: FAIL: " + message)


def token_available() -> bool:
    path = Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser() / "opencode/auth.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8")).get("openai", {})
    except (OSError, ValueError, TypeError):
        return False
    return data.get("type") == "oauth" and bool(data.get("access"))


def choose_model(config: dict) -> str:
    explicit = os.environ.get("CODING_AGENTS_MODEL")
    if explicit:
        return explicit
    openai_models = list(config.get("provider", {}).get("openai", {}).get("models", {}))
    if token_available() and openai_models:
        return "openai/" + openai_models[0]
    return config.get("model", "")



def model_timeout_seconds(model: str, override: str | None = None) -> int:
    """Allow slower self-hosted LLMs to finish without weakening E2E proof."""
    if override is not None:
        try:
            value = int(override)
        except ValueError:
            fail("CODING_AGENTS_TIMEOUT_SECONDS must be a positive integer")
        if value <= 0:
            fail("CODING_AGENTS_TIMEOUT_SECONDS must be a positive integer")
        return value
    return 1200 if model.startswith(("vllm/", "ollama/")) else 180

def unwrap_prs(data: object, depth: int = 0) -> list[int]:
    if depth > 8:
        return []
    if isinstance(data, dict):
        values = data.get("values")
        if isinstance(values, list):
            return [
                entry["id"] for entry in values
                if isinstance(entry, dict)
                and isinstance(entry.get("id"), int)
                and not isinstance(entry.get("id"), bool)
                and entry["id"] > 0
            ]
        for key in ("data", "result", "items", "pullrequests"):
            if key in data:
                result = unwrap_prs(data[key], depth + 1)
                if result:
                    return result
    return []


def inspect_events(output: str, workspace: str = "workspace-example", repo: str = "repo-example") -> tuple[int | None, bool, list[str]]:
    ids: list[int] = []
    texts: list[str] = []
    tools: list[str] = []
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        part = event.get("part")
        if not isinstance(part, dict):
            continue
        if part.get("type") == "text":
            texts.append(part.get("text", ""))
        if part.get("type") != "tool" or part.get("tool") != TOOL:
            continue
        state = part.get("state") or {}
        if state.get("status") != "completed":
            continue
        arguments = state.get("input") or {}
        if (
            arguments.get("action") != "list"
            or arguments.get("workspaceId") != workspace
            or arguments.get("repoId") != repo
        ):
            continue
        raw = state.get("output")
        if not isinstance(raw, str):
            continue
        try:
            data = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(data, dict) or data.get("isError") or data.get("error"):
            continue
        actual = unwrap_prs(data)
        if actual:
            ids.extend(actual)
            tools.append(TOOL)
    verified_id = ids[0] if ids else None
    final_text = texts[-1] if texts else ""
    # An agent finalizing with the real ID shows that it consumed the MCP
    # result, not merely that a tool invocation was emitted.
    referenced_id = (
        verified_id is not None
        and re.search(r"(?<![0-9])" + re.escape(str(verified_id)) + r"(?![0-9])", final_text) is not None
    )
    return verified_id, referenced_id, tools



def session_ids(output: str) -> list[str]:
    """Only IDs emitted by THIS finished OpenCode run may be exported."""
    found = set()
    for line in output.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        candidate = event.get("sessionID")
        if candidate is None and isinstance(event.get("part"), dict):
            candidate = event["part"].get("sessionID")
        if isinstance(candidate, str) and re.fullmatch(r"ses_[A-Za-z0-9]+", candidate):
            found.add(candidate)
    return sorted(found)


def inspect_persisted_proof(stdout: str, env: dict, workspace: str,
                            repo: str) -> tuple[int | None, bool, list[str]]:
    """Cross-check stored MCP receipts when CLI JSON events omit tool parts.

    A bare model answer or an unrelated/stale session NEVER counts as proof.
    The source session must have been identified in the current CLI output,
    be the exact smoke session, and contain a real completed MCP tool part.
    """
    ids = session_ids(stdout)
    if len(ids) != 1:
        return None, False, []
    try:
        result = subprocess.run(
            ["opencode", "export", "--pure", ids[0]],
            stdin=subprocess.DEVNULL, text=True, capture_output=True,
            timeout=30, env=env, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, False, []
    if result.returncode:
        return None, False, []
    try:
        source = json.loads(result.stdout)
    except ValueError:
        return None, False, []
    info = source.get("info") if isinstance(source, dict) else None
    if (not isinstance(info, dict) or info.get("id") != ids[0]
            or info.get("title") != "Bitbucket PR read E2E smoke"):
        return None, False, []
    events = []
    for message in source.get("messages", []):
        if not isinstance(message, dict):
            return None, False, []
        for part in message.get("parts", []):
            if isinstance(part, dict):
                events.append(json.dumps({"part": part}, ensure_ascii=False))
    return inspect_events("\n".join(events), workspace, repo)

def selftest() -> None:
    tool = {
        "type": "tool_use",
        "part": {
            "type": "tool",
            "tool": TOOL,
            "state": {
                "status": "completed",
                "input": {"action": "list", "workspaceId": "workspace-example", "repoId": "repo-example"},
                "output": json.dumps({"values": [{"id": 42}], "pagelen": 1}),
            },
        },
    }
    text = {"type": "text", "part": {"type": "text", "text": "The first PR is #42."}}
    def encode(*events: dict) -> str:
        return "\n".join(json.dumps(event) for event in events)
    if inspect_events(encode(tool, text)) != (42, True, [TOOL]):
        fail("selftest rejected real successful tool evidence")
    if inspect_events(encode(text))[0] is not None:
        fail("selftest accepted hallucinated textual evidence")
    if session_ids(encode(text)) or session_ids("not JSON"):
        fail("selftest accepted a session ID without current-run evidence")
    if session_ids(encode({"sessionID": "ses_abcd1234", "part": {"type": "text"}})) != ["ses_abcd1234"]:
        fail("selftest could not locate legitimate current-run session ID")
    tool["part"]["state"]["status"] = "error"
    if inspect_events(encode(tool, text))[0] is not None:
        fail("selftest accepted errored MCP tool evidence")
    fixture = {
        "mcp": {
            "playwright": {"type": "remote", "enabled": True},
            "atlassian": {"type": "remote", "enabled": True},
            "bitbucket_read": {"type": "local", "enabled": True},
        }
    }
    for mode in ("api-token", "full"):
        filtered = smoke_mcp_config(fixture, mode)
        assert filtered["playwright"]["enabled"] is False
        assert filtered["bitbucket_read"]["enabled"] is True
        assert filtered["atlassian"]["enabled"] is (mode == "full")
    test_config = smoke_tool_output_config({"tool_output": {"max_lines": 300, "max_bytes": 16000}})
    if test_config["tool_output"]["max_bytes"] < 262144:
        fail("selftest: PR output may be truncated before evidence verification")
    if model_timeout_seconds("openai/gpt-5.6-sol") != 180:
        fail("selftest: remote model timeout changed")
    if model_timeout_seconds("vllm/qwen3.8-27b") != 1200:
        fail("selftest: local model timeout too short")
    if model_timeout_seconds("ollama/qwen") != 1200:
        fail("selftest: Ollama timeout too short")
    if model_timeout_seconds("vllm/qwen3.8-27b", "42") != 42:
        fail("selftest: explicit timeout was ignored")
    print("coding-agents-smoke-test: offline selftest PASS")


def smoke_tool_output_config(config: dict) -> dict:
    """Preserve full PR JSON only in the isolated proof session."""
    result = dict(config)
    result["tool_output"] = {"max_lines": 4000, "max_bytes": 262144}
    return result


def smoke_mcp_config(config: dict, mode: str) -> dict:
    """Prevent unrelated MCPs from breaking the isolated Bitbucket E2E test."""
    enabled = {"bitbucket_read"}
    if mode == "full":
        enabled.add("atlassian")
    return {
        name: {**server, "enabled": name in enabled}
        for name, server in config.get("mcp", {}).items()
    }


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "api-token"
    if mode == "--selftest":
        selftest()
        return
    if mode == "oauth":
        print("coding-agents-smoke-test: duplicate OAuth pass skipped (PR already tested)")
        return
    if mode not in ("api-token", "full"):
        fail("expected api-token, oauth or full")

    load_private_config()
    for name in ("BITBUCKET_WORKSPACE", "BITBUCKET_REPOSITORY"):
        if not os.environ.get(name):
            fail(f"{name} is required")

    cfg = Path(
        os.environ.get("CODING_AGENTS_OPENCODE_CONFIG")
        or os.environ.get("OPENCODE_CONFIG")
        or ROOT / ".config/opencode/opencode.json"
    ).expanduser()
    try:
        config = json.loads(cfg.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        fail("OpenCode configuration unreadable")

    model = choose_model(config)
    if not model:
        fail("no model configured for OpenCode")
    if model.startswith("openai/") and not token_available():
        fail("OpenCode OAuth credentials unavailable")

    with tempfile.TemporaryDirectory(prefix="bitbucket-agent-e2e-") as tmp:
        test_config = smoke_tool_output_config(config)
        # Rovo and Atlassian have separate checks; no unrelated MCP (such
        # as Playwright) may influence this isolated Bitbucket proof.
        mcp = smoke_mcp_config(config, mode)
        mcp["bitbucket_read"] = {
            "type": "local",
            "command": [sys.executable, str(ROOT / ".local/bin/bitbucket-read-mcp")],
            "enabled": True,
            "timeout": 120000,
        }
        test_config["mcp"] = mcp
        agent_name = "bitbucket_pr_smoke"
        agents = dict(test_config.get("agent", {}))
        allow = {TOOL: True}
        permission = {"*": "deny", TOOL: "allow"}
        if mode == "full":
            # Never expose Rovo's Jira/Confluence write operations to the
            # automated agent. Only these two verified read tools are allowed.
            for tool in (
                "atlassian_getVisibleJiraProjects",
                "atlassian_getConfluenceSpaces",
            ):
                allow[tool] = True
                permission[tool] = "allow"
        agents[agent_name] = {
            "description": "Read-only test agent. Only approved MCP tools.",
            "mode": "primary",
            "model": model,
            "tools": {"*": False, **allow},
            "permission": permission,
        }
        test_config["agent"] = agents
        test_config["default_agent"] = agent_name
        test_config["tools"] = {"*": False, **allow}
        test_config["permission"] = permission
        config_path = Path(tmp) / "opencode.json"
        config_path.write_text(json.dumps(test_config), encoding="utf-8")
        config_path.chmod(0o600)
        env = os.environ.copy()
        env["OPENCODE_CONFIG"] = str(config_path)
        # Rovo's own smoke tests cover its remote backend. Prefer fast REST
        # here; this remains a genuine call through the same local MCP.
        env["BITBUCKET_READ_BACKEND"] = "rest"
        # Bitbucket's full PR objects often overflow the OpenCode tool-output
        # budget even with pagelen=1. Require genuine bounded REST results.
        env["BITBUCKET_READ_COMPACT_LIST"] = "1"
        prompt = (
            "Use the real MCP tool bitbucket_read_bitbucketPullRequest with "
            f"action=list, workspaceId={os.environ['BITBUCKET_WORKSPACE']}, repoId={os.environ['BITBUCKET_REPOSITORY']}, state=OPEN, pagelen=1. "
            "If none exist, try state=MERGED. Answer with the exact first PR ID "
            "from the returned values, like PR #123. No other tools. Do not invent."
        )
        if mode == "full":
            prompt += (
                " Also call atlassian_getVisibleJiraProjects and "
                "atlassian_getConfluenceSpaces. "
                "Use only these three read-only tools and no writes."
            )
        try:
            run = subprocess.run(
                [
                    "opencode", "run", "--pure", "--format", "json",
                    "--agent", agent_name, "-m", model,
                    "--title", "Bitbucket PR read E2E smoke",
                    prompt,
                ],
                capture_output=True,
                text=True,
                stdin=subprocess.DEVNULL,  # CRITICAL: Bun.stdin.text must see EOF.
                timeout=model_timeout_seconds(model, os.environ.get("CODING_AGENTS_TIMEOUT_SECONDS")),
                env=env,
                check=False,
            )
        except (subprocess.TimeoutExpired, OSError) as exc:
            fail(f"OpenCode run could not complete ({type(exc).__name__})")
        if run.returncode != 0:
            fail(f"OpenCode run returned status {run.returncode}")

    pr_id, cited, tools = inspect_events(run.stdout, os.environ["BITBUCKET_WORKSPACE"], os.environ["BITBUCKET_REPOSITORY"])
    if not tools or pr_id is None:
        pr_id, cited, tools = inspect_persisted_proof(
            run.stdout, env, os.environ["BITBUCKET_WORKSPACE"],
            os.environ["BITBUCKET_REPOSITORY"],
        )
    if not tools or pr_id is None:
        fail("no completed Bitbucket PR MCP tool event with real PR data")
    if not cited:
        fail("model did not reference the PR ID returned by the MCP tool")
    if mode == "full":
        required = {
            "atlassian_getVisibleJiraProjects",
            "atlassian_getConfluenceSpaces",
        }
        completed = set()
        for line in run.stdout.splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            part = event.get("part") or {}
            if not isinstance(part, dict) or part.get("tool") not in required:
                continue
            state = part.get("state") or {}
            output = state.get("output")
            if state.get("status") != "completed" or not isinstance(output, str):
                continue
            try:
                obj = json.loads(output)
            except ValueError:
                obj = None
            if isinstance(obj, dict) and (obj.get("isError") or obj.get("error")):
                continue
            if output.strip() and "MCP error" not in output:
                completed.add(part["tool"])
        if completed != required:
            fail("extended check lacked completed Jira/Confluence read tools")
    print(
        "coding-agents-smoke-test: PASS model="+model
        +" tool="+TOOL
        +" tool_status=completed PR="+str(pr_id)
        +" model_referenced_pr=true"
    )


if __name__ == "__main__":
    main()
