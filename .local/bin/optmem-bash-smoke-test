#!/usr/bin/env bash
set -euo pipefail
mode="${1:-}"
case "$mode" in
  api-token|oauth) ;;
  *) echo "usage: optmem-bash-smoke-test {api-token|oauth}" >&2; exit 2 ;;
esac
cd "$(git rev-parse --show-toplevel)"
root=".local/lib/optmem-bash"
# Only run the expensive synthetic fixtures once for make test; the two
# credential modes exist solely to satisfy the repo-wide smoke contract.
if [[ "$mode" == "oauth" ]]; then
  echo "optmem-bash: oauth smoke not applicable; no external credentials"
  exit 0
fi
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B "$root/test_bash_optmem_agent.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B "$root/writer/test_optmem_writer.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-reconcile/test_reconcile.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_readonly_mcp_unit.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_agent_store.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_agent_mcp.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_snapshot_stage.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_production_preflight.py"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -B ".local/lib/optmem-bridge/test_git_sync.py"
systemd-analyze verify   .config/systemd/user/optmem-bash-capture.service   .config/systemd/user/optmem-bash-capture.timer   .config/systemd/user/optmem-bash-extract.service   .config/systemd/user/optmem-bash-extract.timer
echo "optmem-bash: all isolated acceptance tests passed"
