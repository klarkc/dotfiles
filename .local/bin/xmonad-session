#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-xmonad}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-xmonad}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-xmonad}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

# Shared XMonad GUI locale, for physical X11 and XRDP.
unset LC_ALL LC_MESSAGES
export LANG=pt_BR.UTF-8
export LANGUAGE=pt_BR:pt

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec dbus-run-session -- "$0" "$@"
fi

# Standard ABNT2 layout and CapsLock-as-Escape, independent of XRDP.
if command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap -layout br -variant abnt2 -option caps:escape >/dev/null 2>&1 || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment \
    DBUS_SESSION_BUS_ADDRESS \
    DISPLAY \
    XAUTHORITY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION \
    XDG_SESSION_TYPE \
    XDG_RUNTIME_DIR \
    LANG \
    LANGUAGE || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment \
    DBUS_SESSION_BUS_ADDRESS \
    DISPLAY \
    XAUTHORITY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION \
    XDG_SESSION_TYPE \
    XDG_RUNTIME_DIR || true
fi

start_notification_daemon() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user cat dunst.service >/dev/null 2>&1; then
    pkill -x -u "$(id -u)" dunst >/dev/null 2>&1 || true
    systemctl --user reset-failed dunst.service >/dev/null 2>&1 || true
    systemctl --user start dunst.service >/dev/null 2>&1 || true
    return
  fi

  if command -v dunst >/dev/null 2>&1; then
    pgrep -x -u "$(id -u)" dunst >/dev/null 2>&1 || dunst >/dev/null 2>&1 &
    return
  fi

  if command -v notification-daemon >/dev/null 2>&1; then
    pgrep -f -u "$(id -u)" 'notification-daemon' >/dev/null 2>&1 || notification-daemon >/dev/null 2>&1 &
    return
  fi

  if [ -x /usr/lib/notification-daemon-1.0/notification-daemon ]; then
    pgrep -f -u "$(id -u)" 'notification-daemon' >/dev/null 2>&1 || /usr/lib/notification-daemon-1.0/notification-daemon >/dev/null 2>&1 &
  fi
}

start_notification_daemon

configure_idle_timeout() {
  if command -v xset >/dev/null 2>&1; then
    xset s 600 60 || true
    xset dpms 0 0 900 || true
    xset s on +dpms || true
  fi
}

configure_idle_timeout

start_lock_screen() {
  # In RDP, disconnection must not trigger an unrecoverable automatic locker.
  # Manual Mod-Ctrl-L / i3lock remains available.
  if [ "${SOLO098_GCE_RDP:-0}" = 1 ]; then
    return
  fi
  if command -v xss-lock >/dev/null 2>&1; then
    if ! pgrep -x -u "$(id -u)" xss-lock >/dev/null 2>&1; then
      xss-lock --transfer-sleep-lock -- "$HOME/.local/bin/lock-screen" &
    fi
  fi
}

start_lock_screen

exec xmonad
