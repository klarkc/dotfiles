#!/usr/bin/env python3
"""Native pre-push guard: do not republish the retired Fusion credential history.

Check every ref from Git's pre-push stdin. pre-commit's pre-push dispatcher
only considers the first ref in a multi-ref push and is insufficient here.
No command-line or environment-based bypass is provided.
"""

from __future__ import annotations

import os
from pathlib import Path
import re
import subprocess
import sys
from typing import TextIO

RETIRED_COMMIT = "9a0920ca69ef6cdd4e2162d15c2dc7b9cbfb6bf7"
RETIRED_BLOB = "c3d55cbbede8ae9da2eba3c5560470d7f148da6f"
SHA1 = re.compile(r"^[0-9a-f]{40}$")
ZERO = "0" * 40


class GateError(Exception):
    """Cannot prove that this push is free of the known retired objects."""


def git(*args: str, input_text: str | None = None) -> str:
    env = os.environ.copy()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    try:
        result = subprocess.run(
            ("git", *args),
            input=input_text,
            capture_output=True,
            text=True,
            env=env,
            timeout=90,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise GateError("Git object inspection failed or timed out") from exc
    if result.returncode:
        raise GateError("Git could not inspect all objects in the push")
    return result.stdout.strip()


def inspect_updates(
    updates: TextIO,
    *,
    retired_commit: str = RETIRED_COMMIT,
    retired_blob: str = RETIRED_BLOB,
) -> list[str]:
    """Return unsafe destination refs. Never scan unrelated local branches."""
    if not SHA1.fullmatch(retired_commit) or not SHA1.fullmatch(retired_blob):
        raise GateError("Invalid forbidden-object identifiers")

    proposed: list[tuple[str, str]] = []
    for line in updates:
        fields = line.strip().split()
        if len(fields) != 4:
            raise GateError("Malformed Git pre-push reference update")
        local_ref, local_sha, remote_ref, remote_sha = fields
        if not SHA1.fullmatch(local_sha) or not SHA1.fullmatch(remote_sha):
            raise GateError("Malformed SHA in Git pre-push reference update")
        if local_sha == ZERO:
            continue  # Deleting refs cannot introduce Git objects.
        proposed.append((remote_ref, local_sha))

    if not proposed:
        return []

    if git("rev-parse", "--show-object-format") != "sha1":
        raise GateError("Unsupported Git object format; refusing unchecked push")
    if git("rev-parse", "--is-shallow-repository") != "false":
        raise GateError("Shallow repository cannot prove complete ancestry")
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
    grafts = common / "info" / "grafts"
    if grafts.is_file() and grafts.stat().st_size:
        raise GateError("Git grafts may hide unsafe ancestry")

    def reachable(*tip_shas: str) -> set[str]:
        objects = git(
            "rev-list", "--objects", "--no-object-names", "--stdin",
            input_text="\n".join(tip_shas) + "\n",
        )
        result = set(objects.splitlines())
        if any(not SHA1.fullmatch(oid) for oid in result):
            raise GateError("Git returned unexpected object identifiers")
        return result

    forbidden = {retired_commit, retired_blob}
    tips = tuple(dict.fromkeys(sha for _, sha in proposed))
    if not (reachable(*tips) & forbidden):
        return []
    results = {sha: bool(reachable(sha) & forbidden) for sha in tips}
    return [ref for ref, sha in proposed if results[sha]]


def main() -> int:
    try:
        blocked = inspect_updates(sys.stdin)
    except (GateError, OSError) as exc:
        print(f"\nSECURITY PRE-PUSH: BLOCKED (cannot verify): {exc}", file=sys.stderr)
        print("Do not bypass Git hooks. Check repo integrity and retry.", file=sys.stderr)
        return 1
    if not blocked:
        return 0
    print("\nSECURITY PRE-PUSH: BLOCKED retired Fusion history.", file=sys.stderr)
    for ref in blocked:
        print(f"  Unsafe destination: {ref}", file=sys.stderr)
    print(
        "\nThis push would make a previously exposed Fusion commit or credential "
        "blob reachable again.\n"
        "Agent recovery procedure:\n"
        "  1. STOP. Preserve this worktree, uncommitted files and agent sessions.\n"
        "  2. Do NOT merge the old branch, force-push, delete backups or run gc.\n"
        "  3. Fetch the sanitized origin/main; make an isolated new worktree\n"
        "     based on that history, and port only intended clean changes.\n"
        "  4. Review the diff, run make test and the mandatory commit hooks;\n"
        "     verify the new tip no longer reaches the retired history.\n"
        "  5. Coordinate shared-branch replacements with their owners.\n"
        "For details see AGENTS.md (public history regression guard).\n"
        "GIT_NO_VERIFY bypasses local hooks: never use it to defeat this gate.\n",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
