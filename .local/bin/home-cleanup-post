#!/bin/bash

# Git: Find all .git directories and process them
find ~/{Sources,.herdr/worktrees} -name '.git' -print | while read git_dir; do
  parent_dir=$(dirname "$git_dir")
  echo "Processing git: $parent_dir"
  cd "$parent_dir" || continue
  git stash -u && git clean -fdx -e '.worktrees'
done

# Clean old files in cache
find ~/.config/discord/Cache/Cache_Data -type f -atime +30 -delete
sudo find ~/.cache -type f -atime +30 -not -path '*/yay/*' -delete

# Clean build tools and artifacts
sudo rm -Rf ~/{go,.gradle,.npm}
