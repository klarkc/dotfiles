[Unit]
Description=ZeroClaw daemon
Documentation=https://github.com/zeroclaw-labs/zeroclaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=%h/.nix-profile/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
PassEnvironment=DISPLAY XDG_RUNTIME_DIR
ExecStart=%h/.nix-profile/bin/zeroclaw daemon
Restart=always
RestartSec=3s

NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes

[Install]
WantedBy=default.target
