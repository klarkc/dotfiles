[Unit]
Description=ZeroClaw daemon
Documentation=https://github.com/zeroclaw-labs/zeroclaw
Requires=llm-environment.service
After=network-online.target llm-environment.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=%h/.nix-profile/bin:/usr/bin:/bin
PassEnvironment=ZEROCLAW_channels__discord__default__bot_token ZEROCLAW_providers__models__vllm__default__api_key ZEROCLAW_providers__models__vllm__default__model ZEROCLAW_providers__models__vllm__default__uri
ExecStart=%h/.local/state/nix/profiles/zeroclaw/bin/zeroclaw daemon
Restart=always
RestartSec=3s

NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes

[Install]
WantedBy=default.target
