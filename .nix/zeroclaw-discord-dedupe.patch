+/// Bounded, per-channel idempotency boundary for Discord Gateway redeliveries.
+/// An immutable snowflake is used as the key; identical message text is allowed.
+#[derive(Default)]
+struct SeenDiscordMessages {
+    ids: HashSet<String>,
+    order: VecDeque<String>,
+}
+
+impl SeenDiscordMessages {
+    const CAPACITY: usize = 4096;
+
+    fn admit(&mut self, id: &str) -> bool {
+        if id.is_empty() {
+            return true;
+        }
+        if !self.ids.insert(id.to_owned()) {
+            return false;
+        }
+        self.order.push_back(id.to_owned());
+        if self.order.len() > Self::CAPACITY {
+            if let Some(old) = self.order.pop_front() {
+                self.ids.remove(&old);
+            }
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+mod duplicate_delivery_regression {
+    use super::{DiscordChannel, SeenDiscordMessages};
+    use std::sync::Arc;
+
+    #[test]
+    fn gateway_redelivery_triggers_one_turn() {
+        let channel = DiscordChannel::new(
+            "token".to_string(),
+            vec![],
+            "default",
+            Arc::new(Vec::new),
+            false,
+            false,
+        );
+        assert!(channel.recent_message_ids.lock().admit("12345"));
+        assert!(!channel.recent_message_ids.lock().admit("12345"));
+    }
+
+    #[test]
+    fn same_content_sent_as_distinct_events_is_not_lost() {
+        let mut cache = SeenDiscordMessages::default();
+        assert!(cache.admit("12345"));
+        assert!(cache.admit("12346"));
+        assert!(cache.admit(""));
+    }
+
+    #[test]
+    fn bounded_cache_preserves_recent_ids() {
+        let mut cache = SeenDiscordMessages::default();
+        for id in 0..=SeenDiscordMessages::CAPACITY {
+            assert!(cache.admit(&id.to_string()));
+        }
+        assert_eq!(cache.ids.len(), SeenDiscordMessages::CAPACITY);
+        assert!(!cache.admit(&SeenDiscordMessages::CAPACITY.to_string()));
+        assert!(cache.admit("0")); // Oldest ID expired.
+    }
+
+    #[test]
+    fn concurrent_replay_has_a_single_winner() {
+        let cache = Arc::new(parking_lot::Mutex::new(SeenDiscordMessages::default()));
+        let threads: Vec<_> = (0..12)
+            .map(|_| {
+                let cache = Arc::clone(&cache);
+                std::thread::spawn(move || cache.lock().admit("event-42"))
+            })
+            .collect();
+        assert_eq!(
+            threads
+                .into_iter()
+                .map(|t| t.join().unwrap())
+                .filter(|v| *v)
+                .count(),
+            1
+        );
+    }
+}
