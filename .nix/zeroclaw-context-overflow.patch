 pub fn is_context_window_exceeded(err: &anyhow::Error) -> bool {
+    // Streaming recovery may preserve only a typed terminal classification,
+    // without the original provider error message in the source chain.
+    if err.chain().any(|cause| {
+        cause
+            .downcast_ref::<ReliableProviderTerminalFailure>()
+            .is_some_and(|failure| {
+                failure.kind() == ReliableProviderTerminalFailureKind::ContextWindow
+            })
+    }) {
+        return true;
+    }
