diff --git a/src/local_meeting_ai/adapters/summary/codex.py b/src/local_meeting_ai/adapters/summary/codex.py
new file mode 100644
index 0000000..80d45d1
--- /dev/null
+++ b/src/local_meeting_ai/adapters/summary/codex.py
@@ -0,0 +1,248 @@
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import shutil
+from pathlib import Path
+from typing import Any
+
+import httpx
+
+from local_meeting_ai.application.summary_templates import render_summary_template
+from local_meeting_ai.domain.entities import SummaryResult
+from local_meeting_ai.domain.errors import CapabilityUnavailableError, JobCancelledError
+from local_meeting_ai.domain.protocols import CancellationCheck, ProgressReporter
+
+
+class CodexSummaryEngine:
+    """ChatGPT/Codex OAuth summaries with the configured local engine as fallback."""
+
+    name = "codex"
+
+    def __init__(self, models_dir: Path) -> None:
+        del models_dir
+
+    def capability(self) -> dict[str, Any]:
+        executable = shutil.which("codex")
+        return {
+            "available": executable is not None,
+            "installed": executable is not None,
+            "runtime_available": executable is not None,
+            "models": [
+                {
+                    "id": "gpt-5.6-sol",
+                    "name": "GPT-5.6 Sol (ChatGPT OAuth)",
+                    "provider": "codex",
+                    "repository": "gpt-5.6-sol",
+                    "installed": executable is not None,
+                    "runtime_available": executable is not None,
+                    "managed": False,
+                }
+            ],
+        }
+
+    async def prepare(
+        self,
+        config: dict[str, Any],
+        *,
+        allow_model_download: bool,
+    ) -> None:
+        del allow_model_download
+        executable = str(config.get("codex_path") or "codex")
+        if shutil.which(executable) is None:
+            raise CapabilityUnavailableError("Codex CLI is not installed")
+
+    async def uninstall(self, profile_id: str) -> None:
+        del profile_id
+
+    async def summarize(
+        self,
+        transcript: str,
+        config: dict[str, Any],
+        progress: ProgressReporter,
+        is_cancelled: CancellationCheck,
+    ) -> SummaryResult:
+        if is_cancelled():
+            raise JobCancelledError("Summary generation was cancelled")
+        try:
+            return await self._summarize_codex(
+                transcript, config, progress, is_cancelled
+            )
+        except JobCancelledError:
+            raise
+        except Exception as primary_error:
+            fallback = config.get("fallback")
+            if not isinstance(fallback, dict):
+                raise CapabilityUnavailableError(
+                    f"ChatGPT summary failed and no fallback is configured: {primary_error}"
+                ) from primary_error
+            progress(0.12, "ChatGPT unavailable; using the configured local fallback")
+            try:
+                return await self._summarize_openai_fallback(
+                    transcript, fallback, progress, is_cancelled
+                )
+            except Exception as fallback_error:
+                raise CapabilityUnavailableError(
+                    "Both summary engines failed. "
+                    f"ChatGPT/Codex: {primary_error}; local fallback: {fallback_error}"
+                ) from fallback_error
+
+    async def _summarize_openai_fallback(
+        self,
+        transcript: str,
+        config: dict[str, Any],
+        progress: ProgressReporter,
+        is_cancelled: CancellationCheck,
+    ) -> SummaryResult:
+        base_url = str(config.get("base_url") or "").rstrip("/")
+        model = str(config.get("model") or "").removeprefix("openai/")
+        if not base_url or not model:
+            raise CapabilityUnavailableError(
+                "The local fallback needs an OpenAI-compatible base_url and model"
+            )
+        api_key = str(config.get("api_key") or "")
+        if not api_key:
+            api_key = os.environ.get(
+                str(config.get("api_key_env") or "MEET2NOTES_AI_API_KEY"),
+                "",
+            )
+        system_prompt = str(config.get("system_prompt") or "").strip()
+        prompt = "\n\n".join(
+            part
+            for part in (
+                system_prompt,
+                "Create concise, accurate meeting notes. "
+                "Return only the final summary in Markdown.",
+                f"TRANSCRIPT:\n{transcript}",
+            )
+            if part
+        )
+        progress(0.2, f"Generating summary with local model ({model})")
+        headers = {"Content-Type": "application/json"}
+        if api_key:
+            headers["Authorization"] = f"Bearer {api_key}"
+        payload = {
+            "model": model,
+            "messages": [{"role": "user", "content": prompt}],
+            "max_tokens": int(config.get("max_output_tokens", 1024)),
+            "temperature": float(config.get("temperature", 0.2)),
+            "top_p": float(config.get("top_p", 0.9)),
+        }
+        timeout = float(config.get("request_timeout_seconds", 300))
+        async with httpx.AsyncClient(timeout=timeout) as client:
+            response = await client.post(
+                f"{base_url}/chat/completions",
+                headers=headers,
+                json=payload,
+            )
+        if is_cancelled():
+            raise JobCancelledError("Summary generation was cancelled")
+        response.raise_for_status()
+        body = response.json()
+        choices = body.get("choices") or []
+        content = (
+            str((choices[0].get("message") or {}).get("content") or "").strip()
+            if choices
+            else ""
+        )
+        if not content:
+            raise CapabilityUnavailableError("The local model returned an empty summary")
+        usage = body.get("usage") or {}
+        progress(0.98, "Finalizing the local summary")
+        return SummaryResult(
+            content_markdown=content,
+            prompt_tokens=int(usage.get("prompt_tokens") or 0),
+            completion_tokens=int(usage.get("completion_tokens") or 0),
+        )
+
+    async def _summarize_codex(
+        self,
+        transcript: str,
+        config: dict[str, Any],
+        progress: ProgressReporter,
+        is_cancelled: CancellationCheck,
+    ) -> SummaryResult:
+        executable = str(config.get("codex_path") or "codex")
+        if shutil.which(executable) is None:
+            raise CapabilityUnavailableError("Codex CLI is not installed")
+
+        model = str(config.get("model") or "gpt-5.6-sol")
+        system_prompt = str(config.get("system_prompt") or "").strip()
+        template = config.get("summary_template")
+        task_prompt = (
+            render_summary_template(template)
+            if isinstance(template, dict)
+            else "Create a useful meeting summary with decisions and actions."
+        )
+        prompt = "\n\n".join(
+            part
+            for part in (
+                system_prompt,
+                task_prompt,
+                "Return only the final meeting summary in Markdown. Do not use tools.",
+                f"TRANSCRIPT:\n{transcript}",
+            )
+            if part
+        )
+
+        progress(0.2, f"Generating summary with ChatGPT ({model})")
+        process = await asyncio.create_subprocess_exec(
+            executable,
+            "exec",
+            "--skip-git-repo-check",
+            "--ephemeral",
+            "--ignore-rules",
+            "--ignore-user-config",
+            "-m",
+            model,
+            "-s",
+            "read-only",
+            "--json",
+            "-",
+            stdin=asyncio.subprocess.PIPE,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+        stdout, stderr = await process.communicate(prompt.encode("utf-8"))
+        if is_cancelled():
+            if process.returncode is None:
+                process.kill()
+            raise JobCancelledError("Summary generation was cancelled")
+        if process.returncode != 0:
+            detail = stderr.decode("utf-8", errors="replace").strip()
+            raise CapabilityUnavailableError(
+                f"Codex exited with status {process.returncode}: {detail[-1200:]}"
+            )
+
+        content = ""
+        prompt_tokens = 0
+        completion_tokens = 0
+        for raw_line in stdout.decode("utf-8", errors="replace").splitlines():
+            try:
+                event = json.loads(raw_line)
+            except json.JSONDecodeError:
+                continue
+            if event.get("type") == "item.completed":
+                item = event.get("item") or {}
+                if item.get("type") == "agent_message":
+                    content = str(item.get("text") or "").strip()
+            elif event.get("type") == "turn.completed":
+                usage = event.get("usage") or {}
+                prompt_tokens = int(usage.get("input_tokens") or 0)
+                completion_tokens = int(usage.get("output_tokens") or 0)
+
+        if not content:
+            raise CapabilityUnavailableError("Codex returned an empty summary")
+        progress(0.98, "Finalizing the ChatGPT summary")
+        return SummaryResult(
+            content_markdown=content,
+            prompt_tokens=prompt_tokens,
+            completion_tokens=completion_tokens,
+        )
+
+    def unload(self) -> None:
+        return None
+
+    def shutdown(self) -> None:
+        return None
