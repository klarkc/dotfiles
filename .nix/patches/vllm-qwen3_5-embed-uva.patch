+
+        # The Qwen3.5/3.8 token embedding is roughly 2.37 GiB in BF16. It is
+        # an unusually good offload target: unlike the output head, embedding
+        # lookup reads only the rows for the current token IDs. Keeping it in
+        # pinned host memory therefore frees substantial VRAM without putting
+        # an entire dense decoder layer on PCIe for every generated token.
+        additional_config = vllm_config.additional_config
+        embed_offload_gb = (
+            float(additional_config.get("qwen_embed_offload_gb", 0.0))
+            if isinstance(additional_config, dict)
+            else 0.0
+        )
+        if embed_offload_gb > 0:
+            self._embed_uva_offloader = UVAOffloader(
+                cpu_offload_max_bytes=int(embed_offload_gb * 1024**3),
+                cpu_offload_params={"weight"},
+            )
+            self.embed_tokens = self._embed_uva_offloader.wrap_modules(
+                iter([self.embed_tokens])
+            )[0]
+            logger.info_once(
+                "Qwen token embedding UVA offload enabled (budget %.2f GiB).",
+                embed_offload_gb,
+            )
 
