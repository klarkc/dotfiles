+    #[test]
+    fn provider_timeout_controls_streaming_idle_timeout() {
+        let p = make_model_provider("test", "https://example.com", None);
+        assert_eq!(p.streaming_idle_timeout(), Some(STREAM_IDLE_TIMEOUT));
+
+        let long_timeout = OpenAiCompatibleModelProvider::builder("test")
+            .display_name("test")
+            .base_url("https://example.com")
+            .credential(None)
+            .auth_style(AuthStyle::Bearer)
+            .timeout_secs(86400)
+            .build();
+        assert_eq!(
+            long_timeout.streaming_idle_timeout(),
+            Some(std::time::Duration::from_secs(86400))
+        );
+
+        let no_timeout = OpenAiCompatibleModelProvider::builder("test")
+            .display_name("test")
+            .base_url("https://example.com")
+            .credential(None)
+            .auth_style(AuthStyle::Bearer)
+            .timeout_secs(0)
+            .build();
+        assert_eq!(no_timeout.timeout_secs, 0);
+        assert_eq!(no_timeout.streaming_idle_timeout(), None);
+        // Both connection types must still construct valid clients.
+        let _ = no_timeout.http_client();
+        let _ = no_timeout.streaming_http_client();
+    }
