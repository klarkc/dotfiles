+    /// Nix builds may materialize result links only inside the workspace.
+    /// The daemon-controlled Nix store handles builds with --no-link.
+    /// Landlock also verifies resolved paths against symlink escapes.
+    fn nix_output_target_is_authorized(&self, args: &[String]) -> bool {
+        match args.first().map(String::as_str) {
+            Some("build") => {}
+            None | Some("--version" | "--help" | "-h") => return true,
+            // Require the subcommand first: a global option before build
+            // must not bypass the result-link confinement check.
+            Some(option) if option.starts_with('-') => return false,
+            _ => return true,
+        }
+
+        let mut link = "result";
+        let mut index = 1;
+        while index < args.len() {
+            let arg = args[index].as_str();
+            if arg == "--out-link" || arg == "-o" {
+                let Some(next) = args.get(index + 1) else {
+                    return false;
+                };
+                link = next;
+                index += 2;
+                continue;
+            }
+            if let Some(value) = arg.strip_prefix("--out-link=") {
+                link = value;
+            } else if let Some(value) = arg.strip_prefix("-o") {
+                if !value.is_empty() {
+                    link = value;
+                }
+            }
+            index += 1;
+        }
+
+        // Shell expansion, embedded whitespace and parent traversal are
+        // intentionally unsupported. Require literal, confined link paths.
+        let link = link.trim_matches(|ch| ch == '"' || ch == char::from(39));
+        if link.is_empty()
+            || link.chars().any(|ch| matches!(ch, '$' | '\\' | '*' | '?' | '[' | ']'))
+            || link.contains(char::from(96))
+            || link.chars().any(char::is_whitespace)
+        {
+            return false;
+        }
+        let path = std::path::Path::new(link);
+        if path
+            .components()
+            .any(|part| matches!(part, std::path::Component::ParentDir))
+        {
+            return false;
+        }
+        let target = if path.is_absolute() {
+            path.to_path_buf()
+        } else {
+            self.workspace_dir.join(path)
+        };
+        target.starts_with(&self.workspace_dir)
+    }
