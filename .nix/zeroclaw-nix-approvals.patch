+                    ApprovalRequirement::Approved,
+                ),
+                ApprovalRequirement::Prompt,
+                "must prompt: {command}"
+            );
+        }
+        for command in ["nix --version", "nix build .#hello -o result", "nix run .#hello", "nix develop",
+                        "git -C /home/user/Sources/project status"] {
+            assert_eq!(
+                shell_approval_requirement(
+                    "shell",
+                    &serde_json::json!({"command": command}),
+                    ApprovalRequirement::Approved,
+                ),
+                ApprovalRequirement::Approved,
+                "must auto-approve: {command}"
+            );
+        }
+    }
+}
