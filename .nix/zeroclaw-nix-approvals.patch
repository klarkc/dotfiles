 use crate::approval::{ApprovalRequest, ApprovalRequirement, ApprovalResponse};
 use std::time::Duration;
 
+fn shell_approval_requirement(
+    tool_name: &str,
+    tool_args: &serde_json::Value,
+    requirement: ApprovalRequirement,
+) -> ApprovalRequirement {
+    // Tool-wide shell auto-approval and session Always grants only cover
+    // low-risk commands. Medium/high effects require a fresh human approval.
+    if tool_name == "shell"
+        && requirement == ApprovalRequirement::Approved
+        && tool_args
+            .get("command")
+            .and_then(serde_json::Value::as_str)
+            .is_none_or(|command| {
+                zeroclaw_config::policy::SecurityPolicy::default().command_risk_level(command)
+                    != zeroclaw_config::policy::CommandRiskLevel::Low
+            })
+    {
+        ApprovalRequirement::Prompt
+    } else {
+        requirement
+    }
+}
+
