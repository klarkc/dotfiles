+/// Resolve the Git verb after global options, particularly -C.
+fn git_action_after_global_options(args: &[String]) -> Option<&str> {
+    let mut i = 0;
+    while i < args.len() {
+        match args[i].as_str() {
+            "-c" | "-C" | "--git-dir" | "--work-tree" | "--namespace" => i += 2,
+            arg if arg.starts_with("--git-dir=")
+                || arg.starts_with("--work-tree=")
+                || arg.starts_with("--namespace=")
+                || (arg.starts_with("-C") && arg.len() > 2)
+                || (arg.starts_with("-c") && arg.len() > 2) =>
+            {
+                i += 1;
+            }
+            arg if arg.starts_with('-') => i += 1,
+            verb => return Some(verb),
+        }
+    }
+    None
+}
